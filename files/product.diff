+async function recordListMeasureProof(db:D1Database,
+  call:(name:string,args:Record<string,unknown>)=>Promise<{status:number;body:any}>,
+  adopt:(policy:ReturnType<typeof autonomousPolicy>)=>Promise<void>) {
