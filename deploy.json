{
  "version": 1,
  "project": "just-every/sales-orbit",
  "platforms": [
    "workers",
    "container"
  ],
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "originVar": "AUTH_ORIGIN",
  "vars": {
    "AUTH_LOCAL": "false",
    "MAIL_PROVIDER": "sendgrid",
    "MAIL_RELAY_URL": ""
  },
  "secrets": [
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "MAIL_FROM",
      "environment": "MAIL_FROM",
      "verifyStandIn": "Orbit <auth@native-orbit.example.test>"
    },
    {
      "binding": "SENDGRID_API_KEY",
      "environment": "SENDGRID_API_KEY",
      "optional": true
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY",
      "optional": true
    },
    {
      "binding": "MAIL_REPLY_TO",
      "environment": "MAIL_REPLY_TO",
      "optional": true,
      "verifyStandIn": "reply@native-orbit.example.test"
    },
    {
      "binding": "CAPTURE_MAIL_ADDRESS",
      "environment": "CAPTURE_MAIL_ADDRESS",
      "optional": true
    },
    {
      "binding": "SENDGRID_UNSUBSCRIBE_GROUP_ID",
      "environment": "SENDGRID_UNSUBSCRIBE_GROUP_ID",
      "optional": true,
      "verifyStandIn": "1"
    },
    {
      "binding": "RER_MAIL_RELAY_SECRET",
      "environment": "RER_MAIL_RELAY_SECRET",
      "optional": true
    },
    {
      "binding": "SENDGRID_WEBHOOK_PUBLIC_KEY",
      "environment": "SENDGRID_WEBHOOK_PUBLIC_KEY",
      "optional": true
    },
    {
      "binding": "SENDGRID_PARSE_PUBLIC_KEY",
      "environment": "SENDGRID_PARSE_PUBLIC_KEY",
      "optional": true
    },
    {
      "binding": "ORBIT_ENCRYPTION_KEY",
      "environment": "ORBIT_ENCRYPTION_KEY",
      "verifyStandIn": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    },
    {
      "binding": "OPENAI_API_KEY",
      "environment": "OPENAI_API_KEY",
      "optional": true
    },
    {
      "binding": "AI_MODEL",
      "environment": "AI_MODEL",
      "optional": true,
      "verifyStandIn": "verification-network-edge"
    },
    {
      "binding": "AI_INPUT_COST_PER_MILLION",
      "environment": "AI_INPUT_COST_PER_MILLION",
      "optional": true,
      "verifyStandIn": "0"
    },
    {
      "binding": "AI_OUTPUT_COST_PER_MILLION",
      "environment": "AI_OUTPUT_COST_PER_MILLION",
      "optional": true,
      "verifyStandIn": "0"
    },
    {
      "binding": "AI_CACHED_INPUT_COST_PER_MILLION",
      "environment": "AI_CACHED_INPUT_COST_PER_MILLION",
      "optional": true,
      "verifyStandIn": "0"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "RER_OWNER_CLAIM_ISSUER",
      "environment": "RER_OWNER_CLAIM_ISSUER"
    },
    {
      "binding": "RER_OWNER_CLAIM_INSTALLATION_ID",
      "environment": "RER_OWNER_CLAIM_INSTALLATION_ID"
    },
    {
      "binding": "RER_OWNER_CLAIM_APP_ORIGIN",
      "environment": "RER_OWNER_CLAIM_APP_ORIGIN"
    },
    {
      "binding": "RER_OWNER_CLAIM_PUBLIC_KEYS",
      "environment": "RER_OWNER_CLAIM_PUBLIC_KEYS"
    },
    {
      "binding": "RER_BUSINESS_TRUST",
      "environment": "RER_BUSINESS_TRUST"
    }
  ],
  "crons": [
    "* * * * *"
  ],
  "deployGuide": "https://github.com/just-every/run-orbit#deploy-to-your-cloudflare-account"
}
