// Local Worker configuration. Hosted deployment uses deploy.json through
// rer deploy; this file names no account or remote resource.
{
  "name": "orbit",
  "main": "src/core/app/worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS" },
  "vars": { "MAIL_FROM": "" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orbit-local-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations/core"
    }
  ],
  "triggers": { "crons": ["* * * * *"] }
}
