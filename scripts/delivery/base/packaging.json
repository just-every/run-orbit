{
  "schema": 1,
  "project": {
    "schema": 1,
    "projectId": "just-every/orbit",
    "name": "Orbit",
    "sourceRepository": "https://github.com/just-every/run-orbit",
    "license": "MIT",
    "deployment": {
      "target": "cloudflare-workers",
      "artifactFile": "rer-worker-artifact.json"
    },
    "operations": {
      "setup": "pnpm install --frozen-lockfile && pnpm exec rer install",
      "build": "pnpm exec rer build",
      "verify": "pnpm exec rer verify",
      "artifact": "node scripts/build-delivery-artifact.mjs",
      "recovery": "Retain exact source and a full D1 backup before migrations. Restore to a fresh D1, compare Records archive exports, revoke old authority and reconnect excluded credentials before switching traffic. See OPERATIONS.md and docs/artifact/CONTRACT.md."
    },
    "verification": {
      "sensitivePaths": [
        "src/core/features/auth/**",
        "src/core/features/imports/**",
        "src/modules/import-kit/**",
        "src/modules/schema/**",
        "src/core/features/editor/**",
        "src/core/platform/**",
        "src/core/app/worker.ts",
        "src/base/modules/editor/**",
        "scripts/installer/**",
        "scripts/base-cli/**",
        "scripts/base-onboarding/**",
        "scripts/delivery/**",
        "rer-setup.json",
        ".github/workflows/rer-managed.yml"
      ],
      "migrationDirectories": [
        "migrations/core"
      ],
      "guidanceFiles": [
        "AGENTS.md",
        "CONTRACT.md",
        "OPERATIONS.md"
      ],
      "testPatterns": [
        "tests/**/*.test.*",
        "tests/**/*.spec.*"
      ]
    }
  },
  "managed": {
    "workflowRef": "runeditrun/delivery/.github/workflows/trusted-build.yml@bf7a25abb44bec1457a7bc738ff63921d90fb52e",
    "artifactFile": "rer-worker-artifact.json",
    "buildProfile": "project",
    "verificationProfiles": [
      "full"
    ],
    "pnpmVersion": "10.12.4"
  },
  "setup": {
    "manifestFile": "rer-setup.json"
  },
  "artifact": {
    "specInputs": {
      "publicVariableNames": [
        "AUTH_ORIGIN",
        "OWNER_EMAIL",
        "MAIL_FROM",
        "MAIL_PROVIDER",
        "MAIL_REPLY_TO",
        "SENDGRID_UNSUBSCRIBE_GROUP_ID",
        "SENDGRID_WEBHOOK_PUBLIC_KEY",
        "SENDGRID_PARSE_PUBLIC_KEY",
        "AI_MODEL",
        "AI_INPUT_COST_PER_MILLION",
        "AI_CACHED_INPUT_COST_PER_MILLION",
        "AI_OUTPUT_COST_PER_MILLION",
        "RER_MANAGEMENT_ORIGIN",
        "RER_INSTALLATION_ID"
      ],
      "secretNames": [
        "SETUP_TOKEN"
      ],
      "optionalSecretNames": [
        "SESSION_SECRET",
        "SENDGRID_API_KEY",
        "OPENAI_API_KEY",
        "ORBIT_ENCRYPTION_KEY",
        "RER_MAIL_RELAY_SECRET"
      ],
      "providerEffects": [
        "outbound-mail",
        "ai"
      ],
      "surfaces": {
        "app": {
          "path": "/app",
          "originVariable": "AUTH_ORIGIN",
          "readiness": [
            {
              "path": "/health",
              "statuses": [
                200
              ]
            }
          ]
        }
      },
      "recovery": "Retain exact source and a full D1 backup before migrations. Restore to a fresh D1, compare Records archive exports, revoke old authority and reconnect excluded credentials before switching traffic. See OPERATIONS.md and docs/artifact/CONTRACT.md."
    },
    "mainModule": "index.js"
  }
}
