CREATE TRIGGER fold_epoch_access_invitations_insert AFTER INSERT ON access_invitations WHEN NOT EXISTS(SELECT 1 FROM runtime_controls WHERE name='restore') BEGIN UPDATE access_workspaces SET policy_epoch=policy_epoch+1; END;
CREATE TRIGGER fold_epoch_access_invitations_update AFTER UPDATE ON access_invitations WHEN NOT EXISTS(SELECT 1 FROM runtime_controls WHERE name='restore') BEGIN UPDATE access_workspaces SET policy_epoch=policy_epoch+1; END;
