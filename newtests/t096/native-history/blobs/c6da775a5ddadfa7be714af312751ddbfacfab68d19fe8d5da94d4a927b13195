CREATE TRIGGER fold_epoch_access_role_bundles_update AFTER UPDATE ON access_role_bundles WHEN NOT EXISTS(SELECT 1 FROM runtime_controls WHERE name='restore') BEGIN UPDATE access_workspaces SET policy_epoch=policy_epoch+1; END;
