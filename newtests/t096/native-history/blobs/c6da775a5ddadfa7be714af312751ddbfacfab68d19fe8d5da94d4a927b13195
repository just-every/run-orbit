INSERT INTO runtime_controls(name,value) SELECT 'orbit_fold_legacy_import_preflight',NULL WHERE EXISTS(SELECT 1 FROM archive_jobs WHERE kind='import' AND state NOT IN('complete','aborted'));
-- Forward collision preflight rejects incompatible owner objects before any fold DDL.
SELECT CASE WHEN EXISTS(SELECT 1 FROM sqlite_master WHERE name IN(SELECT value FROM json_each('["access_collaborators","access_form_authorities","access_grants","access_invitations","access_legacy_mapping","access_memberships","access_role_bundles","access_workspaces","access_write_guards","analytics_definitions","analytics_snapshot_sources","analytics_snapshots","archive_fold_generation","archive_job_profiles","archive_legacy_lineage","archive_part_inventory","archive_storage_observations","archive_storage_reservations","consent_events","content_entities","content_revisions","domain_audit","domain_events","fold_artifact_immutable_delete","fold_artifact_immutable_update","fold_capture_erasure","fold_class_no_demotion","fold_class_no_promotion","fold_class_no_rekey","fold_collaborator_membership","fold_content_history_insert","fold_content_history_update","fold_epoch_access_collaborators_delete","fold_epoch_access_collaborators_insert","fold_epoch_access_collaborators_update","fold_epoch_access_grants_delete","fold_epoch_access_grants_insert","fold_epoch_access_grants_update","fold_epoch_access_invitations_delete","fold_epoch_access_invitations_insert","fold_epoch_access_invitations_update","fold_epoch_access_memberships_delete","fold_epoch_access_memberships_insert","fold_epoch_access_memberships_update","fold_epoch_access_role_bundles_delete","fold_epoch_access_role_bundles_insert","fold_epoch_access_role_bundles_update","fold_field_privacy_epoch","fold_graph_companies_delete","fold_graph_companies_insert","fold_graph_companies_update","fold_graph_contacts_delete","fold_graph_contacts_insert","fold_graph_contacts_update","fold_graph_insert_epoch","fold_graph_opportunities_delete","fold_graph_opportunities_insert","fold_graph_opportunities_update","fold_graph_policy_graph_records_delete","fold_graph_policy_graph_records_update","fold_graph_policy_schema_types_delete","fold_graph_policy_schema_types_update","fold_graph_population","fold_graph_search_delete","fold_graph_search_insert","fold_graph_search_update","fold_native_provision","fold_native_status","fold_provision_no_collaborator","fold_record_privacy_epoch","fold_report_company_erasure","fold_report_contact_erasure","fold_report_opportunity_erasure","fold_restore_projection_release","fold_search_record","fold_search_values_delete","fold_search_values_insert","fold_search_values_update","fold_workspace_bootstrap","fold_workspace_singleton","graph_records","graph_workspace_epochs","marketing_form_submissions","original_operator_provisions","publication_operations","publication_targets","record_search_fields","record_search_values","schema_types"]'))) THEN json_extract('ORBIT_FOLD_SCHEMA_COLLISION','$') ELSE 1 END;
-- Fold generation 1: one native workspace, with a separate invited collaborator class.
CREATE TABLE access_workspaces(id TEXT PRIMARY KEY, tenant_id TEXT NOT NULL, name TEXT NOT NULL, policy_epoch INTEGER NOT NULL DEFAULT 1 CHECK(policy_epoch>0));
CREATE TABLE access_legacy_mapping(singleton INTEGER PRIMARY KEY CHECK(singleton=1), tenant_id TEXT NOT NULL, workspace_id TEXT NOT NULL REFERENCES access_workspaces(id));
CREATE TABLE access_memberships(workspace_id TEXT NOT NULL REFERENCES access_workspaces(id), operator_id TEXT NOT NULL REFERENCES operators(id), role TEXT NOT NULL, status TEXT NOT NULL CHECK(status IN('active','removed')), created_at TEXT NOT NULL, PRIMARY KEY(workspace_id,operator_id));
-- Deliberately precedes operator insertion during invitation; this records explicit class intent.
CREATE TABLE access_collaborators(operator_id TEXT PRIMARY KEY, invited_at TEXT NOT NULL);
CREATE TABLE access_invitations(id TEXT PRIMARY KEY,workspace_id TEXT NOT NULL REFERENCES access_workspaces(id),email TEXT NOT NULL,role TEXT NOT NULL,invited_by TEXT NOT NULL REFERENCES operators(id),token_hash TEXT NOT NULL UNIQUE,expires_at TEXT NOT NULL,accepted_by TEXT,revoked_at TEXT,created_at TEXT NOT NULL);
CREATE TABLE access_role_bundles(workspace_id TEXT NOT NULL REFERENCES access_workspaces(id),role TEXT NOT NULL,actions_json TEXT NOT NULL,fields_json TEXT NOT NULL,PRIMARY KEY(workspace_id,role));
CREATE TABLE access_grants(id TEXT PRIMARY KEY,tenant_id TEXT NOT NULL,workspace_id TEXT NOT NULL REFERENCES access_workspaces(id),subject_kind TEXT NOT NULL CHECK(subject_kind='operator'),subject_id TEXT NOT NULL,resource_type TEXT NOT NULL,resource_id TEXT NOT NULL,actions_json TEXT NOT NULL,fields_json TEXT NOT NULL,purpose TEXT NOT NULL,expires_at TEXT,revoked_at TEXT,created_at TEXT NOT NULL);
CREATE TABLE access_write_guards(id TEXT PRIMARY KEY,allowed INTEGER NOT NULL CHECK(allowed=1));
CREATE TABLE original_operator_provisions(operator_id TEXT PRIMARY KEY REFERENCES operators(id),created_at TEXT NOT NULL);
INSERT INTO access_workspaces SELECT 'workspace','orbit',name,1 FROM workspace_settings;
INSERT INTO access_legacy_mapping SELECT 1,'orbit','workspace' FROM workspace_settings;
INSERT INTO access_memberships SELECT 'workspace',id,'legacy_operator',status,created_at FROM operators WHERE EXISTS(SELECT 1 FROM workspace_settings);
INSERT INTO original_operator_provisions SELECT id,created_at FROM operators;
CREATE TRIGGER fold_workspace_singleton BEFORE INSERT ON access_workspaces WHEN EXISTS(SELECT 1 FROM access_workspaces) BEGIN SELECT RAISE(ABORT,'ORBIT_ONE_WORKSPACE'); END;
CREATE TRIGGER fold_workspace_bootstrap AFTER INSERT ON workspace_settings WHEN NOT EXISTS(SELECT 1 FROM runtime_controls WHERE name='restore') BEGIN
 INSERT INTO access_workspaces VALUES('workspace','orbit',NEW.name,1);
 INSERT INTO access_legacy_mapping VALUES(1,'orbit','workspace');
 INSERT INTO access_memberships SELECT 'workspace',id,'legacy_operator',status,created_at FROM operators WHERE NOT EXISTS(SELECT 1 FROM access_collaborators c WHERE c.operator_id=operators.id);
END;
CREATE TRIGGER fold_native_provision AFTER INSERT ON operators WHEN NOT EXISTS(SELECT 1 FROM access_collaborators WHERE operator_id=NEW.id) AND NOT EXISTS(SELECT 1 FROM runtime_controls WHERE name='restore') BEGIN
 INSERT INTO original_operator_provisions VALUES(NEW.id,NEW.created_at);
 INSERT INTO access_memberships SELECT workspace_id,NEW.id,'legacy_operator',NEW.status,NEW.created_at FROM access_legacy_mapping;
END;
CREATE TRIGGER fold_native_status AFTER UPDATE OF status ON operators WHEN NOT EXISTS(SELECT 1 FROM runtime_controls WHERE name='restore') BEGIN
 UPDATE access_memberships SET status=NEW.status WHERE operator_id=NEW.id AND (NEW.status='removed' OR NOT EXISTS(SELECT 1 FROM access_collaborators WHERE operator_id=NEW.id));
END;
CREATE TRIGGER fold_class_no_demotion BEFORE INSERT ON access_collaborators WHEN NOT EXISTS(SELECT 1 FROM runtime_controls WHERE name='restore') AND EXISTS(SELECT 1 FROM operators WHERE id=NEW.operator_id) BEGIN SELECT RAISE(ABORT,'NATIVE_OPERATOR_CLASS_IMMUTABLE'); END;
CREATE TRIGGER fold_class_no_promotion BEFORE DELETE ON access_collaborators WHEN NOT EXISTS(SELECT 1 FROM runtime_controls WHERE name='restore') BEGIN SELECT RAISE(ABORT,'COLLABORATOR_CLASS_IMMUTABLE'); END;
CREATE TRIGGER fold_class_no_rekey BEFORE UPDATE ON access_collaborators WHEN NOT EXISTS(SELECT 1 FROM runtime_controls WHERE name='restore') BEGIN SELECT RAISE(ABORT,'COLLABORATOR_CLASS_IMMUTABLE'); END;
CREATE TRIGGER fold_collaborator_membership BEFORE INSERT ON access_memberships WHEN NOT EXISTS(SELECT 1 FROM runtime_controls WHERE name='restore') AND EXISTS(SELECT 1 FROM access_collaborators WHERE operator_id=NEW.operator_id) AND NOT EXISTS(SELECT 1 FROM access_invitations i JOIN operators o ON o.email=i.email WHERE o.id=NEW.operator_id AND i.workspace_id=NEW.workspace_id AND i.accepted_by=NEW.operator_id AND i.revoked_at IS NULL) BEGIN SELECT RAISE(ABORT,'COLLABORATOR_ACCEPTANCE_REQUIRED'); END;
CREATE TRIGGER fold_provision_no_collaborator BEFORE INSERT ON original_operator_provisions WHEN NOT EXISTS(SELECT 1 FROM runtime_controls WHERE name='restore') AND EXISTS(SELECT 1 FROM access_collaborators WHERE operator_id=NEW.operator_id) BEGIN SELECT RAISE(ABORT,'COLLABORATOR_IS_NOT_NATIVE'); END;
CREATE TRIGGER fold_epoch_access_memberships_insert AFTER INSERT ON access_memberships WHEN NOT EXISTS(SELECT 1 FROM runtime_controls WHERE name='restore') BEGIN UPDATE access_workspaces SET policy_epoch=policy_epoch+1; END;
CREATE TRIGGER fold_epoch_access_memberships_update AFTER UPDATE ON access_memberships WHEN NOT EXISTS(SELECT 1 FROM runtime_controls WHERE name='restore') BEGIN UPDATE access_workspaces SET policy_epoch=policy_epoch+1; END;
CREATE TRIGGER fold_epoch_access_memberships_delete AFTER DELETE ON access_memberships WHEN NOT EXISTS(SELECT 1 FROM runtime_controls WHERE name='restore') BEGIN UPDATE access_workspaces SET policy_epoch=policy_epoch+1; END;
