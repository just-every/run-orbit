import { sendSendGrid } from '../../modules/sendgrid-email/sender';

export interface AuthMailer {
  send(input: { email: string; url: string; deliveryId: string }): Promise<void>;
}
export interface AuthConfiguration { origin: string; mailer: AuthMailer }
export interface AuthEnvironment { AUTH_ORIGIN?: string; MAIL_FROM?: string; SENDGRID_API_KEY?: string }

export function createAuthConfiguration(env: AuthEnvironment): AuthConfiguration | undefined {
  const names = ['AUTH_ORIGIN', 'MAIL_FROM', 'SENDGRID_API_KEY'] as const;
  // The deployment origin also identifies a public, not-yet-configured install.
  // Mail credentials opt in to authentication; an origin alone is not a partial mailer.
  if (!env.MAIL_FROM?.trim() && !env.SENDGRID_API_KEY?.trim()) {
    if (env.AUTH_ORIGIN) validateOrigin(env.AUTH_ORIGIN);
    return undefined;
  }
  const missing = names.filter((name) => !env[name]?.trim());
  if (missing.length) throw new Error(`Magic-link authentication requires ${missing.join(', ')}.`);
  const origin = validateOrigin(env.AUTH_ORIGIN!);
  return { origin: origin.origin, mailer: { async send(input) {
    await sendSendGrid({ apiKey: env.SENDGRID_API_KEY!, message: {
      from: env.MAIL_FROM!, to: [input.email], subject: 'Sign in to Orbit',
      text: `Sign in to Orbit: ${input.url}\n\nThis single-use link expires in 15 minutes. If you did not request it, ignore this email.`,
      deliveryId: input.deliveryId,
    } });
  } } };
}

function validateOrigin(value:string) {
  let origin:URL;try{origin=new URL(value);}catch{throw new Error('AUTH_ORIGIN must be an HTTPS origin without a path.');}
  if(origin.protocol!=='https:'||origin.origin!==value||origin.username||origin.password)throw new Error('AUTH_ORIGIN must be an HTTPS origin without a path.');
  return origin;
}
