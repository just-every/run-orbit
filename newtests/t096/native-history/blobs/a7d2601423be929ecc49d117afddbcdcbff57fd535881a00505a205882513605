import {useEffect,useState} from 'react';
import {OperatorState} from './operator-shell';
interface Total {day:string;feature:string;provider:string;model:string;calls:number;inputTokens:number;outputTokens:number;cachedInputTokens:number;estimatedCost:number}
export function AIUsage(){const [rows,setRows]=useState<Total[]>([]),[error,setError]=useState(''),[configured,setConfigured]=useState(false);useEffect(()=>{let active=true;void fetch('/api/v1/assistance/usage').then(async response=>{if(!response.ok)throw new Error('AI usage could not load.');const data=await response.json() as {totals:Total[];configured:boolean};if(active){setRows(data.totals);setConfigured(data.configured);}}).catch(e=>{if(active)setError((e as Error).message);});return()=>{active=false;};},[]);return <section className="operator-surface workbench-form"><h2>AI usage and estimated cost</h2><p>{configured?'Provider configured.':'AI is not configured. Manual work remains available.'} Costs use the owner’s configured rates and are estimates rather than invoices. Cached input tokens are recorded; when no cached rate is configured, estimates use the normal input rate.</p>{error&&<OperatorState kind="error">{error}</OperatorState>}{rows.length?<div tabIndex={0} role="region" aria-label="AI usage table" style={{overflowX:'auto'}}><table><caption>Usage by day and feature</caption><thead><tr><th>Day</th><th>Feature</th><th>Model</th><th>Calls</th><th>Input</th><th>Cached input</th><th>Output</th><th>Estimated USD</th></tr></thead><tbody>{rows.map(row=><tr key={`${row.day}:${row.feature}:${row.model}`}><td>{row.day}</td><td>{row.feature}</td><td>{row.provider} / {row.model}</td><td>{row.calls}</td><td>{row.inputTokens}</td><td>{row.cachedInputTokens}</td><td>{row.outputTokens}</td><td>{row.estimatedCost.toFixed(6)}</td></tr>)}</tbody></table></div>:<p>No AI calls recorded.</p>}</section>;}
