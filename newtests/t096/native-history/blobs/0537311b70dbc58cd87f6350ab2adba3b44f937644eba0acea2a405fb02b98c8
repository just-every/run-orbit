import { identityMatch, identityPatterns } from './erasure-identity';
import { executeArchiveErasure } from './archive-erasure';
import { evaluationStatements } from '../workbench/evaluation-repository';
import { createId } from '../../shared/ids';
import { audit, RecordError, requireRecord, type RecordKind } from './shared';
export class DataRepository {
 constructor(readonly db:D1Database){}
 async remove(kind:RecordKind,id:string,actor:string){const record=await requireRecord(this.db,kind,id);const statements:D1PreparedStatement[]=[];
  if(kind==='company')statements.push(this.db.prepare('DELETE FROM companies WHERE id=?').bind(id));
  if(kind==='opportunity'){
   // Preserve provider-accepted content as durable customer activities before removing opportunity FKs.
   const messages=(await this.db.prepare("SELECT * FROM outbound_messages WHERE opportunity_id=? AND state IN ('accepted','delivered','bounced','delivery-unknown')").bind(id).all<Record<string,any>>()).results;
   for(const message of messages){const entry=createId();statements.push(this.db.prepare("INSERT INTO timeline_entries VALUES(?,'outbound.archived',?,?,'operator',?,'mail',?)").bind(entry,message.created_at,new Date().toISOString(),message.operator_id,JSON.stringify(message)));if(message.contact_id)statements.push(this.db.prepare("INSERT INTO timeline_entry_records VALUES(?,'contact',?)").bind(entry,message.contact_id));if(record.company_id)statements.push(this.db.prepare("INSERT INTO timeline_entry_records VALUES(?,'company',?)").bind(entry,record.company_id));}

   statements.push(this.db.prepare('UPDATE ai_calls SET error=NULL WHERE opportunity_id=?').bind(id),this.db.prepare("INSERT OR IGNORE INTO timeline_entry_records SELECT r.timeline_entry_id,'contact',oc.contact_id FROM timeline_entry_records r JOIN opportunity_contacts oc ON oc.opportunity_id=r.record_id JOIN timeline_entries t ON t.id=r.timeline_entry_id WHERE r.record_type='opportunity' AND r.record_id=? AND t.kind LIKE '%accepted%'").bind(id),this.db.prepare('DELETE FROM outbound_messages WHERE opportunity_id=?').bind(id),this.db.prepare('DELETE FROM evaluation_job_runs WHERE opportunity_id=?').bind(id),this.db.prepare('DELETE FROM action_completions WHERE recommendation_id IN(SELECT id FROM recommendations WHERE opportunity_id=?)').bind(id),this.db.prepare('DELETE FROM ai_previews WHERE opportunity_id=?').bind(id),this.db.prepare('DELETE FROM notifications WHERE opportunity_id=?').bind(id),this.db.prepare('DELETE FROM opportunities WHERE id=?').bind(id));
  }
  if(kind==='contact'){
   const affected=(await this.db.prepare('SELECT opportunity_id FROM opportunity_contacts WHERE contact_id=?').bind(id).all<{opportunity_id:string}>()).results;
   // Remove every signal carrying this contact, including copies linked to other records.
   const signalIds="SELECT signal_id FROM record_erasure_signals WHERE contact_id=?";
   const aliases=(await this.db.prepare("SELECT identity_key FROM record_aliases WHERE record_type='contact' AND survivor_id=?").bind(id).all<{identity_key:string}>()).results.map(row=>row.identity_key);
   const identities=[...new Set([record.email,...aliases].filter((value):value is string=>typeof value==='string'&&value.length>0))];
   statements.push(this.db.prepare("INSERT OR IGNORE INTO record_erasure_signals SELECT ?,signal_id FROM signal_links WHERE record_type='contact' AND record_id=?").bind(id,id));
   for(const value of identities)statements.push(this.db.prepare(`INSERT OR IGNORE INTO record_erasure_signals SELECT ?,id FROM signals WHERE ${identityMatch('payload_json')}`).bind(id,...identityPatterns(value)));
   statements.push(this.db.prepare(`DELETE FROM unlinked_signals WHERE signal_id IN (${signalIds})`).bind(id));
   statements.push(this.db.prepare("UPDATE audit_entries SET entity_id='erased',details_json='{}' WHERE entity_type='contact' AND entity_id IN(SELECT retired_id FROM record_merge_claims WHERE record_type='contact' AND survivor_id=?)").bind(id),this.db.prepare("UPDATE audit_entries SET details_json='{}' WHERE EXISTS(SELECT 1 FROM record_merge_claims m WHERE m.record_type='contact' AND m.survivor_id=? AND instr(audit_entries.details_json,m.retired_id)>0)").bind(id));
   // Display names are not identities: unrelated customers may share them.
   // Attribute name-bearing content through contact/opportunity links instead.
   for(const opportunity of affected)statements.push(this.db.prepare('UPDATE ai_calls SET error=NULL WHERE opportunity_id=?').bind(opportunity.opportunity_id));
   for(const value of identities){const patterns=identityPatterns(value);statements.push(this.db.prepare(`DELETE FROM handoff_tasks WHERE ${identityMatch('title')} OR ${identityMatch('description')}`).bind(...patterns,...patterns),this.db.prepare(`UPDATE ai_calls SET error=NULL WHERE ${identityMatch('error')}`).bind(...patterns),this.db.prepare(`DELETE FROM ai_previews WHERE ${identityMatch('content_json')}`).bind(...patterns),this.db.prepare(`DELETE FROM unlinked_replies WHERE ${identityMatch('sender')}`).bind(...patterns),this.db.prepare(`DELETE FROM notifications WHERE ${identityMatch('message')}`).bind(...patterns),this.db.prepare(`UPDATE audit_entries SET details_json='{}' WHERE ${identityMatch('details_json')}`).bind(...patterns),this.db.prepare(`DELETE FROM timeline_entries WHERE ${identityMatch('payload_json')}`).bind(...patterns));}
   statements.push(this.db.prepare('DELETE FROM ai_previews WHERE recipient_contact_id=? OR instr(content_json,?)>0').bind(id,id),this.db.prepare('DELETE FROM notifications WHERE opportunity_id IN (SELECT opportunity_id FROM opportunity_contacts WHERE contact_id=?)').bind(id),this.db.prepare('DELETE FROM outbound_messages WHERE contact_id=? OR draft_id IN (SELECT id FROM drafts WHERE recipient_contact_id=?)').bind(id,id),this.db.prepare('DELETE FROM drafts WHERE recipient_contact_id=?').bind(id));
   statements.push(this.db.prepare(`DELETE FROM action_completions WHERE recommendation_id IN(SELECT recommendation_id FROM recommendation_evidence WHERE signal_id IN (${signalIds}))`).bind(id));
   statements.push(this.db.prepare(`DELETE FROM recommendations WHERE id IN(SELECT recommendation_id FROM recommendation_evidence WHERE signal_id IN (${signalIds}))`).bind(id),this.db.prepare(`DELETE FROM evaluations WHERE id IN(SELECT evaluation_id FROM evaluation_contributions WHERE signal_id IN (${signalIds}))`).bind(id));
   statements.push(this.db.prepare(`DELETE FROM timeline_entries WHERE id IN(SELECT timeline_entry_id FROM timeline_entry_records WHERE record_type='contact' AND record_id=?) OR json_extract(payload_json,'$.contactId')=? OR json_extract(payload_json,'$.signalId') IN (${signalIds}) OR EXISTS(SELECT 1 FROM json_each(timeline_entries.payload_json,'$.contactIds') WHERE value=?)`).bind(id,id,id,id));
   statements.push(this.db.prepare(`DELETE FROM signals WHERE id IN(${signalIds})`).bind(id),this.db.prepare("UPDATE audit_entries SET entity_id='erased',details_json='{}' WHERE (entity_type='contact' AND entity_id=?) OR instr(details_json,?)>0").bind(id,id),this.db.prepare('DELETE FROM contacts WHERE id=?').bind(id));
   statements.push(this.db.prepare("UPDATE opportunity_contacts SET is_primary=1 WHERE contact_id=(SELECT MIN(c.contact_id) FROM opportunity_contacts c WHERE c.opportunity_id=opportunity_contacts.opportunity_id) AND NOT EXISTS(SELECT 1 FROM opportunity_contacts p WHERE p.opportunity_id=opportunity_contacts.opportunity_id AND p.is_primary=1)"));
   statements.push(this.db.prepare('DELETE FROM record_erasure_signals WHERE contact_id=?').bind(id));
   for(const opportunity of affected)statements.push(...evaluationStatements(this.db,opportunity.opportunity_id,actor,'Contact erased'));
  }
  statements.push(this.db.prepare('DELETE FROM record_merge_claims WHERE record_type=? AND (survivor_id=? OR retired_id=?)').bind(kind,id,id),this.db.prepare('DELETE FROM record_aliases WHERE record_type=? AND survivor_id=?').bind(kind,id),this.db.prepare('DELETE FROM timeline_entry_records WHERE record_type=? AND record_id=?').bind(kind,id),this.db.prepare('DELETE FROM signal_links WHERE record_type=? AND record_id=?').bind(kind,id),audit(this.db,actor,'record.deleted',kind,kind==='contact'?'erased':id));
  if(kind==='contact')await executeArchiveErasure(this.db,statements);else await this.db.batch(statements);return {deleted:true};
 }
}
