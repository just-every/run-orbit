CREATE TABLE analytics_definitions(id TEXT NOT NULL,tenant_id TEXT NOT NULL,workspace_id TEXT NOT NULL,version INTEGER NOT NULL,body_json TEXT NOT NULL,created_at TEXT NOT NULL,PRIMARY KEY(workspace_id,id,version));
CREATE TABLE analytics_snapshots(id TEXT PRIMARY KEY,tenant_id TEXT NOT NULL,workspace_id TEXT NOT NULL,definition_id TEXT NOT NULL,definition_version INTEGER NOT NULL,body_json TEXT NOT NULL,created_at TEXT NOT NULL);
CREATE TABLE analytics_snapshot_sources(snapshot_id TEXT NOT NULL REFERENCES analytics_snapshots(id) ON DELETE CASCADE,ordinal INTEGER NOT NULL CHECK(ordinal>=0),tenant_id TEXT NOT NULL,workspace_id TEXT NOT NULL,kind TEXT NOT NULL,record_id TEXT NOT NULL,revision INTEGER NOT NULL,data_epoch INTEGER NOT NULL,PRIMARY KEY(snapshot_id,ordinal));
CREATE TABLE domain_events(event_id TEXT PRIMARY KEY,tenant_id TEXT NOT NULL,workspace_id TEXT NOT NULL,aggregate_type TEXT NOT NULL,aggregate_id TEXT NOT NULL,aggregate_version INTEGER NOT NULL,kind TEXT NOT NULL,occurred_at TEXT NOT NULL,received_at TEXT NOT NULL,actor_json TEXT NOT NULL,correlation_id TEXT NOT NULL,payload_ref TEXT NOT NULL,access_epoch INTEGER NOT NULL);
CREATE TABLE domain_audit(id TEXT PRIMARY KEY,tenant_id TEXT NOT NULL,workspace_id TEXT NOT NULL,actor_json TEXT NOT NULL,operation TEXT NOT NULL,resource_json TEXT NOT NULL,occurred_at TEXT NOT NULL,details_ref TEXT NOT NULL,correlation_id TEXT NOT NULL);
CREATE TRIGGER fold_report_contact_erasure AFTER DELETE ON contacts WHEN NOT EXISTS(SELECT 1 FROM runtime_controls WHERE name='restore') BEGIN DELETE FROM analytics_snapshots WHERE id IN(SELECT snapshot_id FROM analytics_snapshot_sources WHERE kind='contact' AND record_id=OLD.id) OR EXISTS(SELECT 1 FROM json_each(analytics_snapshots.body_json,'$.inputs') ref WHERE json_extract(ref.value,'$.type')='contact' AND json_extract(ref.value,'$.id')=OLD.id);END;
