import {WorkspaceArchiveTools} from './WorkspaceArchiveTools';
import { parseCsv } from '../../../shared/csv';
import { useState } from 'react';
import { recordsRequest,type RecordKind } from './records-api';
export function RecordsDataTools({kind,onChanged}:{kind:RecordKind;onChanged:()=>void}){const [csv,setCsv]=useState(''),[mapping,setMapping]=useState<Record<string,string>>({}),[headers,setHeaders]=useState<string[]>([]),[result,setResult]=useState<any>(),[groups,setGroups]=useState<any[][]>([]),[pair,setPair]=useState<any[]|null>(null),[choices,setChoices]=useState<Record<string,string>>({}),[error,setError]=useState('');async function run(work:()=>Promise<any>){try{setError('');setResult(await work());onChanged();}catch(e){setError((e as Error).message);}}
 const fields=kind==='contact'?['name','email','phone','job_title','timezone','company_id','contactability','custom_fields_json']:['name','primary_domain','custom_fields_json'];
 return <details className="operator-surface workbench-form"><summary>Import, duplicate review and data export</summary>{kind!=='opportunity'?<><h2>Import {kind==='company'?'companies':'contacts'}</h2><label>CSV file<input type="file" accept=".csv,text/csv" onChange={async e=>{try{const source=await e.target.files?.[0]?.text()??'';setCsv(source);setHeaders(parseCsv(source)[0]??[]);setMapping({});}catch(e){setError((e as Error).message);}}}/></label><fieldset><legend>Map CSV columns</legend>{['id',...fields.filter(f=>f!=='custom_fields_json')].map(field=><label key={field}>{field.replaceAll('_',' ')}<select value={mapping[field]??''} onChange={e=>{const next={...mapping};if(e.target.value)next[field]=e.target.value;else delete next[field];setMapping(next);}}><option value="">Do not import</option>{headers.map(header=><option key={header}>{header}</option>)}</select></label>)}</fieldset><p>The import report identifies each created, updated and failed row.</p><button onClick={()=>run(()=>recordsRequest(`records/${kind}/import`,'POST',{csv,mapping}))}>Import mapped rows</button><h2>Duplicate candidates</h2><button onClick={()=>run(async()=>{const data=await recordsRequest<{groups:any[][]}>(`records/${kind}/duplicates`);setGroups(data.groups);return {candidateGroups:data.groups.length};})}>Find matching names</button>{groups.map((group,i)=><div key={i}>{group.map(record=><button key={record.id} onClick={()=>{setPair(pair?.length===1?[pair[0],record]:[record]);setChoices({});}}>{record.name} · {record.id}</button>)}</div>)}{pair?.length===1?<p>Survivor: {pair[0].name}. Select a second record to retire.</p>:null}{pair?.length===2?<section><h3>Survivor: {pair[0].name} ({pair[0].id})</h3>{fields.filter(f=>pair[0][f]!==pair[1][f]).map(field=><label key={field}>{field.replaceAll('_',' ').replace(/^./,letter=>letter.toUpperCase())}<select required value={choices[field]??''} onChange={e=>setChoices({...choices,[field]:e.target.value})}><option value="">Choose a value</option><option value="survivor">Keep: {String(pair[0][field]??'empty')}</option><option value="retired">Use: {String(pair[1][field]??'empty')}</option></select></label>)}<button onClick={()=>{if(confirm('Merge these records and retire the second record?'))void run(()=>recordsRequest(`records/${kind}/merge`,'POST',{survivorId:pair[0].id,retiredId:pair[1].id,choices,confirmed:true}));}}>Confirm merge</button></section>:null}</>:null}
 <WorkspaceArchiveTools/>{error?<p role="alert">{error}</p>:null}{result?<pre style={{whiteSpace:'pre-wrap'}}>{JSON.stringify(result,null,2)}</pre>:null}</details>;
