import type { PropsWithChildren } from "react";
import { Link } from "@tanstack/react-router";

type ButtonKind = "primary" | "secondary" | "quiet";
type IconName = "arrow" | "information";

export function OrbitIcon({ className = "", name }: { className?: string; name: IconName }) {
  return <span aria-hidden="true" className={`orbit-icon orbit-icon--${name} ${className}`} />;
}

interface OrbitLinkProps extends PropsWithChildren {
  to: "/" | "/signin" | "/demo";
  kind?: ButtonKind;
  className?: string;
}

export function OrbitLink({ children, className = "", kind = "primary", to }: OrbitLinkProps) {
  return (
    <Link className={`orbit-button orbit-button--${kind} ${className}`} to={to}>
      {children}
    </Link>
  );
}

export function Surface({ children, className = "" }: PropsWithChildren<{ className?: string }>) {
  return <section className={`orbit-surface ${className}`}>{children}</section>;
}

export function ConfigurationNotice({ children }: PropsWithChildren) {
  return (
    <aside className="configuration-notice" role="note">
      <OrbitIcon name="information" />
      <div>{children}</div>
    </aside>
  );
}
