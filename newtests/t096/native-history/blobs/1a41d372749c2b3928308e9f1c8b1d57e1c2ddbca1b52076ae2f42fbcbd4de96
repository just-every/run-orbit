CREATE TABLE delegation_installation (id TEXT PRIMARY KEY, epoch INTEGER NOT NULL DEFAULT 0);
INSERT INTO delegation_installation VALUES (lower(hex(randomblob(16))),0);
CREATE TABLE delegation_clients (id TEXT PRIMARY KEY, redirect_uri TEXT NOT NULL, origin TEXT NOT NULL, allow_loopback INTEGER NOT NULL DEFAULT 0, enabled INTEGER NOT NULL DEFAULT 1);
CREATE TABLE delegation_grants (id TEXT PRIMARY KEY, client_id TEXT NOT NULL REFERENCES delegation_clients(id), principal_id TEXT NOT NULL REFERENCES operators(id) ON DELETE CASCADE, account_id TEXT NOT NULL, scopes_json TEXT NOT NULL, targets_json TEXT NOT NULL, expires_at TEXT NOT NULL, revoked_at TEXT, token_hash TEXT UNIQUE, consent_key TEXT UNIQUE);
CREATE TABLE delegation_codes (hash TEXT PRIMARY KEY, grant_id TEXT NOT NULL REFERENCES delegation_grants(id) ON DELETE CASCADE, challenge TEXT NOT NULL, expires_at TEXT NOT NULL, consumed_at TEXT);
CREATE TABLE delegation_guards (id TEXT PRIMARY KEY, valid INTEGER NOT NULL CONSTRAINT delegation_guards_current CHECK(valid=1));
CREATE TABLE handoff_tasks (id TEXT PRIMARY KEY, opportunity_id TEXT NOT NULL REFERENCES opportunities(id) ON DELETE CASCADE, title TEXT NOT NULL, description TEXT NOT NULL, assignee_id TEXT REFERENCES operators(id) ON DELETE SET NULL, due_at TEXT, status TEXT NOT NULL CHECK(status IN ('open','completed','cancelled')), source_client_id TEXT, actor_id TEXT NOT NULL, revision TEXT NOT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL);
CREATE TABLE handoff_contacts (handoff_id TEXT NOT NULL REFERENCES handoff_tasks(id) ON DELETE CASCADE, contact_id TEXT NOT NULL REFERENCES contacts(id) ON DELETE CASCADE, PRIMARY KEY(handoff_id,contact_id));
CREATE INDEX handoff_opportunity ON handoff_tasks(opportunity_id);
CREATE TABLE delegation_receipts (id TEXT PRIMARY KEY, client_id TEXT NOT NULL, principal_id TEXT NOT NULL, account_id TEXT NOT NULL, operation_key TEXT NOT NULL, target TEXT NOT NULL, request_hash TEXT NOT NULL, receipt_json TEXT NOT NULL, UNIQUE(client_id,principal_id,account_id,operation_key));
CREATE TRIGGER delegation_operator_removed AFTER UPDATE OF status ON operators WHEN NEW.status='removed' BEGIN
UPDATE delegation_grants SET revoked_at=strftime('%Y-%m-%dT%H:%M:%fZ','now') WHERE principal_id=NEW.id;
UPDATE handoff_tasks SET assignee_id=NULL,revision=lower(hex(randomblob(16))) WHERE assignee_id=NEW.id AND status='open';
END;
CREATE TRIGGER delegation_contact_erased BEFORE DELETE ON contacts BEGIN
DELETE FROM timeline_entries WHERE source='orbit-handoff' AND id IN (SELECT timeline_entry_id FROM timeline_entry_records WHERE record_type='opportunity' AND record_id IN (SELECT opportunity_id FROM opportunity_contacts WHERE contact_id=OLD.id));
DELETE FROM handoff_tasks WHERE opportunity_id IN (SELECT opportunity_id FROM opportunity_contacts WHERE contact_id=OLD.id) OR id IN (SELECT handoff_id FROM handoff_contacts WHERE contact_id=OLD.id);
END;
