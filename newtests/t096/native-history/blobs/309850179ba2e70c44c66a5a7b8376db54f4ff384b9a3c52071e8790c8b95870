import { ApprovalRepository, type ApprovalInput } from '../outreach/approval-repository';
import { workingDaysAfter } from '../outreach/time';
import { createId } from '../../shared/ids';
import { commercialEmailKey } from '../../../family/sales/identity';
import { WorkbenchError, WorkbenchRepository } from './repository';

export class OutreachRepository {
  constructor(private readonly db: D1Database) {}
  async createDraft(opportunityId: string, input: { contactId: string; subject: string; body: string }, actor: string) {
    const contact = await this.db.prepare("SELECT c.id,c.email,c.contactability FROM contacts c JOIN opportunity_contacts oc ON oc.contact_id=c.id JOIN opportunities o ON o.id=oc.opportunity_id WHERE oc.opportunity_id=? AND c.id=? AND o.lifecycle='open'").bind(opportunityId,input.contactId).first<{id:string;email:string;contactability:string}>();
    if (!contact || !contact.email) throw new WorkbenchError(400,'Choose a linked contact with an email on an open opportunity.');
    if(contact.contactability !== 'contactable') throw new WorkbenchError(409,'This contact must not be contacted.');
    const recommendation = await this.db.prepare('SELECT id FROM recommendations WHERE opportunity_id=? AND is_current=1').bind(opportunityId).first<{id:string}>();
    const id=createId(), now=new Date().toISOString();
    await this.db.batch([
      this.db.prepare('INSERT INTO drafts(id,opportunity_id,recommendation_id,author_id,recipient_contact_id,recipient_email,subject,body,revision,is_stale,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?,1,0,?,?)').bind(id,opportunityId,recommendation?.id??null,actor,contact.id,commercialEmailKey(contact.email),input.subject,input.body,now,now),
      ...new WorkbenchRepository(this.db).timeline(opportunityId,actor,'draft.created',{draftId:id,manual:true},now)
    ]);
    return {id};
  }
  async claim(draftId:string,revision:number,actor:string,input:ApprovalInput={}) {
    return new ApprovalRepository(this.db).approve(draftId,revision,actor,input);
  }
  async settle(id: string, actor: string, state: 'accepted'|'failed'|'delivery-unknown'|'reconciling', providerId: string|null, failure: string|null) {
    const message = await this.db.prepare('SELECT opportunity_id,recipient_email,subject,body FROM outbound_messages WHERE id=?').bind(id).first<{opportunity_id:string;recipient_email:string;subject:string;body:string}>();
    if(!message) throw new Error('Outbound approval is missing.');
    const now = new Date(), at = now.toISOString(), settlementId = createId();
    const statements = [this.db.prepare('UPDATE outbound_messages SET state=?,provider_message_id=?,failure=?,updated_at=?,settlement_id=? WHERE id=? AND state IN (\'queued\',\'reconciling\',\'delivery-unknown\')').bind(state,providerId,failure,at,settlementId,id),
      ...new WorkbenchRepository(this.db).timeline(message.opportunity_id,actor,`message.${state}`,{messageId:id,providerId,failure,...(state==='accepted'?{recipient:message.recipient_email,subject:message.subject,body:message.body}:{})},at,at,settlementId)];
    if(state==='accepted') {
      const settings=await this.db.prepare("SELECT timezone,awaiting_response_working_days FROM workspace_settings WHERE id='workspace'").first<{timezone:string;awaiting_response_working_days:number}>();
      if(!settings)throw new Error('Workspace settings missing.');
      const due=workingDaysAfter(now,settings.awaiting_response_working_days,settings.timezone);
      statements.push(this.db.prepare("UPDATE opportunities SET queue_state='next',queue_reason='Awaiting customer response',next_due_at=?,updated_at=? WHERE id=? AND lifecycle='open' AND EXISTS(SELECT 1 FROM outbound_messages m JOIN drafts d ON d.id=m.draft_id WHERE m.settlement_id=? AND d.is_stale=0 AND d.revision=m.revision)").bind(due.toISOString(),at,message.opportunity_id,settlementId));
    }
    if(state==='accepted') statements.push(
      this.db.prepare("UPDATE recommendations SET is_current=0,superseded_at=?,updated_at=? WHERE id=(SELECT d.recommendation_id FROM outbound_messages m JOIN drafts d ON d.id=m.draft_id WHERE m.settlement_id=?)").bind(at,at,settlementId)
    );
    if(state==='failed'||state==='delivery-unknown'||state==='reconciling') statements.push(this.db.prepare("UPDATE opportunities SET queue_state='now',queue_reason=?,next_due_at=NULL,updated_at=? WHERE id=? AND lifecycle='open' AND EXISTS(SELECT 1 FROM outbound_messages WHERE settlement_id=?)").bind(state==='failed'?'Delivery failure':'Delivery unresolved',at,message.opportunity_id,settlementId));
    await this.db.batch(statements);
  }
  async messages(opportunityId: string) {return (await this.db.prepare('SELECT id,draft_id AS draftId,state,recipient_email AS recipientEmail,subject,body,provider_message_id AS providerMessageId,failure,next_attempt_at AS retryAfter,scheduled_at AS scheduledAt,created_at AS createdAt FROM outbound_messages WHERE opportunity_id=? ORDER BY created_at DESC').bind(opportunityId).all()).results;}
}
