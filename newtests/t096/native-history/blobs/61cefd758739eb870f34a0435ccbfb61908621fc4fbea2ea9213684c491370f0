/* Contact editor alignment: approved 12ui contact screen, 13 September 2026. */
.records-tabs {display:flex;gap:8px;flex-wrap:wrap;margin:20px 0 24px;border-bottom:1px solid #e8e5df;padding-bottom:12px}
.records-tabs button,.records-secondary-action {border:1px solid #dedbd4;border-radius:6px;padding:9px 15px;background:transparent;font-size:13px;color:#53564f;cursor:pointer}
.records-tabs button[aria-pressed=true] {background:#f0eee8;color:#1f2822;border-color:#bbbeb5;font-weight:600}
.records-tabs button:disabled {opacity:.55;cursor:wait}
.record-editor {gap:20px;margin-top:20px;grid-template-columns:minmax(0,1.94fr) minmax(240px,1fr)}
.record-editor .operator-surface {border-radius:11px;border-color:#e7e3db;box-shadow:0 8px 25px #40321e04;background:#fffefa}
.record-editor .workbench-form {padding:24px;gap:24px}
.record-editor .workbench-form h2,.record-editor .workbench-summary h2,.record-editor__history h3 {font:700 10px/1.4 Arial,sans-serif;letter-spacing:.11em;text-transform:uppercase;color:#737570}
.record-editor .workbench-form input,.record-editor .workbench-form select {padding:9px 11px;min-height:38px;font-size:14px;background:transparent;border-color:#e5e0d8}
.record-editor .workbench-form label {font-size:14px;gap:8px}
.record-editor .workbench-form>p {font-size:12px;line-height:1.5;color:#72736c;margin-top:-12px}
.record-editor .workbench-summary {padding:24px}
.record-editor .workbench-summary dl {margin-top:19px}
.record-editor .workbench-summary dl div {display:grid;grid-template-columns:92px minmax(0,1fr);gap:12px;border:0;padding:11px 0;align-items:start}
.record-editor .workbench-summary dt {font-size:11px;line-height:1.5;text-transform:none;color:#777971}
.record-editor .workbench-summary dd {font-size:12px;line-height:1.5;margin:0;color:#434541}
.record-editor__history {border-top:1px solid #ebe7e0;margin-top:28px;padding-top:24px}
.record-editor__history p {padding-left:24px;margin:20px 0;font-size:12px;line-height:1.6;color:#555850;background:url('../../../../assets/design/record-created-marker.png') no-repeat left 3px;background-size:12px 16px}
.record-editor__history p:last-child {background-image:url('../../../../assets/design/record-updated-marker.png')}
.record-editor .workbench-actions {grid-column:1/-1;margin-top:28px;padding:24px;min-height:94px;box-shadow:none}
.record-editor .operator-button {font-size:13px;padding:11px 20px;border-radius:6px}
.record-custom-fields {border:0;border-top:1px solid #ebe7e0;padding:24px 0 0;display:grid;gap:14px;min-width:0}
.record-custom-fields legend {font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:#737570;padding-right:12px}
.record-custom-fields__row {display:grid;grid-template-columns:minmax(0,1fr) 110px;gap:12px}
.record-custom-fields button {justify-self:start;font-size:12px;text-decoration:underline;color:#38624b}
.record-custom-fields__row button {grid-column:1/-1}
.records-detail-list {display:grid;gap:16px;grid-template-columns:repeat(2,minmax(0,1fr));margin:0}
.records-detail-list dt {color:#74766e;font-size:11px;text-transform:uppercase;letter-spacing:.04em}
.records-detail-list dd {margin:5px 0 0;overflow-wrap:anywhere;font-size:14px}
.records-workspace .operator-queue-card>button {display:block;width:100%;min-width:0;max-width:100%;white-space:normal;text-align:left;padding:20px 24px}
.records-workspace .operator-queue-card h2 {font-size:22px;margin:0 0 8px}
.records-workspace .operator-queue-card p {margin:0;color:#72756d;font-size:13px}
.records-workspace fieldset,.settings-layout fieldset,.manual-entry fieldset {min-width:0}
.record-editor input[type=checkbox],.settings-layout input[type=checkbox],.manual-entry input[type=checkbox] {width:16px;min-height:16px;margin-right:8px}
.settings-layout .workbench-summary article {padding:18px 0;border-bottom:1px solid #e8e5df}
.settings-layout .workbench-summary article p {overflow-wrap:anywhere;font-size:13px}
.settings-layout .workbench-summary button {font-size:12px;text-decoration:underline}
.settings-layout .workbench-summary form {margin-top:24px}
@media(max-width:700px){.record-editor{grid-template-columns:minmax(0,1fr)}.record-editor .workbench-summary{grid-row:auto}.record-editor .workbench-summary dl div{grid-template-columns:100px minmax(0,1fr)}.record-editor .workbench-form,.record-editor .workbench-summary{padding:20px}.records-detail-list{grid-template-columns:1fr}.record-custom-fields__row{grid-template-columns:minmax(0,1fr)}.record-editor .workbench-actions{margin-top:0}}

/* Preserve full related names without intrinsic grid expansion or clipped text. */
.records-workspace .workbench-create > *, .record-editor .workbench-create__fields {min-width:0}
.records-workspace .workbench-summary p, .records-workspace .workbench-summary a {overflow-wrap:anywhere}
.record-editor .workbench-form label {min-width:0;overflow-wrap:anywhere}
.record-editor fieldset label {grid-template-columns:16px minmax(0,1fr);align-items:start}
.record-editor fieldset label input[type=checkbox] {margin:3px 0 0}

.records-workspace .workbench-form {min-width:0;overflow-wrap:anywhere}
.records-workspace .workbench-form pre {overflow-wrap:anywhere}

.records-workspace .workbench-actions {flex-wrap:wrap}
