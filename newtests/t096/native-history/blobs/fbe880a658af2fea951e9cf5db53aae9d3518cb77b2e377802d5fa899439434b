    ring('upright-orbit', 1.67, 1.69, .22, .45, .62),
    ring('outer-orbit', 2.52, 2.5, .30, 0, .3),
    ring('dashed-orbit', 3.48, 1.53, .36, -.08, .34, true),
    ring('polar-orbit', 2.94, 3.03, .22, 0, .42, true),
