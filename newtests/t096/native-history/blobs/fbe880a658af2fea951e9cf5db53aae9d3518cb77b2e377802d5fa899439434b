import * as THREE from 'three';
import { preloadSurfaces, buildSurfaceTextures } from './surfaces.js';
import { createGeometry, sourcePoint } from './geometry.js';
import { createTargetingSequence } from './targeting-sequence.js';
export const preloadScene = preloadSurfaces;

