export function protectResponse(response:Response){const headers=new Headers(response.headers);headers.set('Content-Security-Policy',"frame-ancestors 'none'");headers.set('X-Frame-Options','DENY');headers.set('X-Content-Type-Options','nosniff');headers.set('Referrer-Policy','same-origin');return new Response(response.body,{status:response.status,statusText:response.statusText,headers});}
