import { contactStopStatements } from '../records/suppression-effects';
import { weights } from '../workbench/policies';
import { createId } from '../../shared/ids';
import type { SourceSecurity } from '../../platform/source-security';
import { evaluationStatements } from '../workbench/evaluation-repository';
import { confidence, IngestionError, type SignalEvent } from './contracts';
import { resolveTarget, targetsFor, type SignalTarget } from './linking-repository';
import { mailboxStopStatements, stopsMailbox } from './stop-repository';
import { linkTargetFence } from './linking-fence';

export class IngestionRepository {
  constructor(readonly db:D1Database){}
  async source(id:string){return this.db.prepare('SELECT id,enabled,secret_ciphertext FROM signal_sources WHERE id=?').bind(id).first<{id:string;enabled:number;secret_ciphertext:string|null}>();}
  async sources(){return (await this.db.prepare('SELECT id,name,type,enabled,last_accepted_at,last_error,rejected_count,cursor FROM signal_sources ORDER BY name').all()).results;}
  async configure(input:{id:string;name:string;secret:string;enabled:boolean},security:SourceSecurity){const now=new Date().toISOString();await this.db.prepare("INSERT INTO signal_sources(id,name,type,enabled,created_at,updated_at,secret_ciphertext) VALUES(?,?,'signed_webhook',?,?,?,?) ON CONFLICT(id) DO UPDATE SET name=excluded.name,enabled=excluded.enabled,secret_ciphertext=excluded.secret_ciphertext,updated_at=excluded.updated_at").bind(input.id,input.name,Number(input.enabled),now,now,await security.seal(input.secret)).run();}
  async reject(source:string,eventId:string|null,reason:string){const now=new Date().toISOString();await this.db.batch([this.db.prepare('UPDATE signal_sources SET last_error=?,rejected_count=rejected_count+1,updated_at=? WHERE id=?').bind(reason,now,source),this.db.prepare('INSERT INTO source_event_errors(id,source_id,source_event_id,reason,created_at) VALUES(?,?,?,?,?)').bind(createId(),source,eventId,reason,now)]);}
  async ingest(source:string,event:SignalEvent,hash:string,raw:string){
    const existing=await this.existing(source,event.eventId);if(existing)return this.replay(existing,hash);
    const plan=await this.prepare(source,event,hash,raw);
    try{await this.db.batch(plan.statements);}catch(error){const raced=await this.existing(source,event.eventId);if(raced)return this.replay(raced,hash);throw error;}
    return {id:plan.id,linked:plan.linked};
  }
  async prepare(source:string,event:SignalEvent,hash:string,raw:string){
    const target=await resolveTarget(this.db,event),id=createId(),at=new Date().toISOString();
    const targets=target?await targetsFor(this.db,target):[];
    const statements=[this.db.prepare('INSERT INTO signals(id,source_id,source_event_id,type,subject,occurred_at,received_at,payload_hash,confidence,linking_basis,created_at,payload_json) VALUES(?,?,?,?,?,?,?,?,?,?,?,?)').bind(id,source,event.eventId,event.type,event.subject,event.occurredAt,at,hash,confidence(event.type),target?.basis??'Unlinked',at,raw),
      this.db.prepare('UPDATE signal_sources SET last_accepted_at=?,updated_at=? WHERE id=?').bind(at,at,source),
      ...await mailboxStopStatements(this.db,event,at),
      ...await this.linkStatements(id,event,targets,source,at)];
    if(!target)statements.push(this.db.prepare('INSERT INTO unlinked_signals(signal_id,reason) VALUES(?,?)').bind(id,['page.viewed','chat.started','content.downloaded'].includes(event.type)&&!event.identityBasis?'Source visitor identity basis is missing':'No unique record match'));
    return {id,linked:Boolean(target),statements};
  }
  private async existing(source:string,eventId:string){return this.db.prepare('SELECT id,payload_hash FROM signals WHERE source_id=? AND source_event_id=?').bind(source,eventId).first<{id:string;payload_hash:string}>();}
  private replay(row:{id:string;payload_hash:string},hash:string){if(row.payload_hash!==hash)throw new IngestionError(409,'Source event identity already carries different payload.');return {id:row.id,replayed:true};}
  async linkStatements(id:string,event:SignalEvent,targets:SignalTarget[],actor:string,at:string,actorType:'source'|'operator'='source',sourceName=actor){
    const statements=linkTargetFence(this.db,event,targets,actorType==='operator');
    if(targets.length)statements.push(this.db.prepare("INSERT INTO timeline_entries(id,kind,occurred_at,recorded_at,actor_type,actor_id,source,payload_json) VALUES(?,'signal.recorded',?,?,?,?,?,?)").bind(id,event.occurredAt,at,actorType,actor,sourceName,JSON.stringify({signalId:id,subject:event.subject})));
    for(const target of targets){statements.push(this.db.prepare('INSERT INTO signal_links(signal_id,record_type,record_id,linking_basis,linked_at) VALUES(?,?,?,?,?)').bind(id,target.type,target.id,target.basis,at),this.db.prepare('INSERT INTO timeline_entry_records(timeline_entry_id,record_type,record_id) VALUES(?,?,?)').bind(id,target.type,target.id));if(target.type==='opportunity'&&(weights[event.type]??0)!==0)statements.push(...evaluationStatements(this.db,target.id,actor,'New customer evidence',new Date(at)));}
    const contacts=targets.filter(target=>target.type==='contact');
    if((['email.replied','meeting.booked'].includes(event.type)||stopsMailbox(event))&&!(stopsMailbox(event)&&event.email!==undefined))for(const contact of contacts){
      statements.push(this.db.prepare("UPDATE drafts SET is_stale=1,stale_reason='Customer stop event',updated_at=? WHERE recipient_contact_id=?").bind(at,contact.id),this.db.prepare("UPDATE outbound_messages SET state='cancelled',failure='Customer stop event',updated_at=? WHERE contact_id=? AND state='scheduled'").bind(at,contact.id));
      if(event.type==='email.unsubscribed'||event.permanentBounce)statements.push(...await contactStopStatements(this.db,contact.id));
    }
    if(['email.replied','email.bounced'].includes(event.type))for(const target of targets.filter(t=>t.type==='opportunity'))statements.push(this.db.prepare("UPDATE opportunities SET queue_state='now',queue_reason=?,next_due_at=NULL,updated_at=? WHERE id=? AND lifecycle='open'").bind(event.type==='email.replied'?'Customer reply':'Delivery problem',at,target.id));
    return statements;
  }
  async unlinked(){return (await this.db.prepare('SELECT s.id,s.source_id,s.type,s.subject,s.occurred_at,u.reason FROM unlinked_signals u JOIN signals s ON s.id=u.signal_id WHERE u.resolved_at IS NULL ORDER BY s.received_at DESC LIMIT 100').all()).results;}
  async link(id:string,target:SignalTarget,actor:string){
    const signal=await this.db.prepare('SELECT s.payload_json FROM signals s JOIN unlinked_signals u ON u.signal_id=s.id WHERE s.id=? AND u.resolved_at IS NULL').bind(id).first<{payload_json:string}>();if(!signal)throw new IngestionError(409,'Signal is already linked or missing.');
    const event=JSON.parse(signal.payload_json) as SignalEvent;
    // Visitor data lacking a basis must not become contact history through review either.
    if(['page.viewed','chat.started','content.downloaded'].includes(event.type)&&!event.identityBasis)throw new IngestionError(409,'A source-held visitor identity basis is required.');
    const resolved=await resolveTarget(this.db,{...event,record:{type:target.type,id:target.id}});if(!resolved)throw new IngestionError(404,'Record not found.');
    const at=new Date().toISOString();await this.db.batch([...await this.linkStatements(id,event,await targetsFor(this.db,{...resolved,basis:'Operator reviewed record link'}),actor,at,'operator','operator.review'),this.db.prepare('UPDATE unlinked_signals SET resolved_at=? WHERE signal_id=?').bind(at,id)]);
  }
}
