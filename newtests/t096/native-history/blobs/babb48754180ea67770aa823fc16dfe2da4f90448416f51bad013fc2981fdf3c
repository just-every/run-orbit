import { createId } from '../../shared/ids';
import { RecordError } from './shared';
import { archiveCatalog, archiveHash, validateManifest, validatePart, type ArchiveManifest } from './archive-schema';
import { partStatements, stageTables } from './archive-storage';
import { uploadStatements } from './archive-stage-upload';
import { advanceImport, abortImport, type ImportJob } from './archive-import-progress';
export class ArchiveImportRepository {
    constructor(readonly db: D1Database) { }
    async job(id: string, actor: string) { const job = await this.db.prepare("SELECT * FROM archive_jobs WHERE id=? AND kind='import' AND actor_id=?").bind(id, actor).first<ImportJob>(); if (!job)
        throw new RecordError(404, 'Archive import not found.'); return job; }
    async status(id: string, actor: string) { const job = await this.job(id, actor), progress = JSON.parse(job.progress_json || '{}'); const nextPart = (await this.db.prepare('SELECT count(*) AS n FROM archive_parts WHERE job_id=?').bind(id).first<{
        n: number;
    }>())!.n; return { id, state: job.state, manifest: JSON.parse(job.manifest_json), nextPart, phase: progress.phase, completedTables: progress.table ?? 0, totalTables: JSON.parse(job.manifest_json).tables.length }; }
    async create(input: unknown, actor: string) { const { manifest, catalog } = await validateManifest(this.db, input); const id = createId(); await this.db.batch([this.db.prepare("INSERT INTO archive_jobs(id,kind,state,actor_id,manifest_json,created_at) VALUES(?,'import','uploading',?,?,?)").bind(id, actor, JSON.stringify(manifest), new Date().toISOString()), ...stageTables(this.db, id, catalog)]); return this.status(id, actor); }
    async upload(id: string, index: number, input: unknown, actor: string) {
        const job = await this.job(id, actor), manifest: ArchiveManifest = JSON.parse(job.manifest_json), catalog = await archiveCatalog(this.db), part = validatePart(input, catalog, manifest);
        if (index !== part.index || index >= manifest.parts || await archiveHash(part.records) !== part.sha256)
            throw new RecordError(400, 'Archive part index or checksum does not match.');
        const previous = await this.db.prepare('SELECT sha256 FROM archive_parts WHERE job_id=? AND part_index=?').bind(id, index).first<{
            sha256: string;
        }>();
        if (previous) {
            if (previous.sha256 !== part.sha256)
                throw new RecordError(409, 'This part was already uploaded with different contents.');
            return this.status(id, actor);
        }
        if (job.state !== 'uploading')
            throw new RecordError(409, 'This import no longer accepts new parts.');
        const count = (await this.db.prepare('SELECT count(*) AS n FROM archive_parts WHERE job_id=?').bind(id).first<{
            n: number;
        }>())!.n;
        if (index !== count)
            throw new RecordError(409, 'Upload the next missing archive part first.');
        // A request contains at most 1000 rows. Stage typed cells, never JSON-expanded D1 rows.
        await this.db.batch([...partStatements(this.db, id, part), ...uploadStatements(this.db, id, part, catalog)]);
        return this.status(id, actor);
    }
    async advance(id: string, actor: string) { const job = await this.job(id, actor); await advanceImport(this.db, job); return this.status(id, actor); }
    async abort(id: string, actor: string) { const job = await this.job(id, actor); await abortImport(this.db, job); return this.status(id, actor); }
}
