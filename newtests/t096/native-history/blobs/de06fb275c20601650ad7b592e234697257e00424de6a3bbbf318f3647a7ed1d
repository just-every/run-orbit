@media (max-width:700px) { .demo-page__grid, .demo-card--editor { grid-template-columns:1fr; } .demo-card__heading { align-items:start; flex-direction:column; gap:8px; } .demo-page__form-footer .orbit-button { width:100%; } }

/* New forms use the retained Orbit branch: paper panels and summary column. */
.workbench-create { display:grid;grid-template-columns:minmax(0,2fr) minmax(220px,1fr);gap:20px;margin-top:30px;align-items:start; }
.workbench-create__fields,.workbench-evidence { display:grid;gap:20px; }
.workbench-form,.workbench-summary { padding:24px; }
.workbench-form { display:grid;gap:18px; }
.workbench-form h2,.workbench-summary h2 { margin:0;font-family:Georgia,serif;font-weight:400; }
.workbench-form label { display:grid;gap:7px;font-size:14px; }
.workbench-form input,.workbench-form select,.workbench-form textarea { width:100%;min-width:0;border:1px solid #d8d5ce;border-radius:6px;padding:11px;background:#fffdf9;font:inherit; }
.workbench-form-row { display:grid;grid-template-columns:1fr 1fr;gap:18px; }
.workbench-summary dl div { padding:16px 0;border-bottom:1px solid #e3dfd6; }
.workbench-summary dt { font-size:11px;text-transform:uppercase;color:#68706d; }
.workbench-summary dd { margin:8px 0 0;overflow-wrap:anywhere; }
.workbench-actions { grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;padding:22px;gap:15px; }
.workbench-evidence { margin-top:24px; }
.operator-button { display:inline-block;cursor:pointer;border:0;border-radius:6px;padding:12px 18px;background:#087a42;color:white;text-decoration:none;font:inherit;font-weight:600;justify-self:start; }
.operator-button:disabled { opacity:.55;cursor:default; }
@media(max-width:700px) { .workbench-create,.workbench-form-row { grid-template-columns:1fr; }.workbench-summary{grid-row:2}.workbench-form,.workbench-summary{padding:18px}.operator-nav{gap:12px} }
.workbench-create__fields .workbench-form h2 { font-family:inherit;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#ff4d25; }
.workbench-summary h2 { font-size:22px; }
.workbench-actions > a { border:1px solid #cbc8c0;border-radius:6px;padding:10px 24px;color:inherit;text-decoration:none; }

/* Request preview panels follow the accepted 12ui assistance branch. */
.assistance-preview-json { white-space: pre-wrap; overflow-wrap: anywhere; font: 0.84rem/1.6 ui-monospace, monospace; max-width: 100%; }
.operator-surface label { display: grid; gap: .45rem; margin-bottom: 1rem; }
.operator-surface input,.operator-surface select,.operator-surface textarea { max-width: 100%; font: inherit; padding: .7rem; border: 1px solid #d7d8d2; border-radius: .4rem; background: #fffefc; color: #14251f; }
@media(max-width:900px) {
 .operator-header { flex-wrap:wrap; gap:8px 18px; }
 .operator-header > form { margin-left:auto; }
 .operator-nav { order:3; flex-basis:100%; flex-wrap:wrap; gap:4px 18px; }
 .operator-nav a { white-space:normal; }
}

.source-table-wrap {max-width:100%; overflow:auto; margin-top:20px;}
.source-table {width:100%; min-width:650px; border-collapse:collapse; font-size:.9rem; text-align:left;}
.source-table th,.source-table td {padding:14px 12px; border-bottom:1px solid var(--operator-border,#ded5cc); vertical-align:top;}
.source-table th {font-size:.74rem; letter-spacing:.06em; text-transform:uppercase; color:#655e58;}
.source-table td small {display:block; margin-top:5px; overflow-wrap:anywhere; color:#655e58;}
.source-table td:first-child {min-width:180px;}

.notification-filters {display:flex; align-items:center; gap:28px; margin:24px 0;}
.notification-filters label {min-width:0; flex:1;}
.notification-layout {display:grid; gap:20px; margin-top:24px;}
.notification-layout.has-selection {grid-template-columns:minmax(0,1.3fr) minmax(280px,1fr);}
.notification-list {list-style:none; padding:0; margin:0;}
.notification-list li {display:flex; align-items:start; gap:18px; padding:24px 0; border-bottom:1px solid #e4dcd3;}
.notification-list li:first-child {padding-top:0;}
.notification-list li:last-child {border-bottom:0;}
.notification-list li>div {flex:1; min-width:0;}
.notification-icon {width:38px; height:40px; object-fit:contain; flex:none;}
.notification-title {font-family:Georgia,serif; font-size:1.35rem; line-height:1.3; text-align:left; color:#22201c;}
.notification-list p {font-size:.9rem; color:#655e58; margin:8px 0;}
.notification-list .is-unread {border-left:3px solid #c9370b; padding-left:14px;}
.notification-detail {align-self:start; display:grid; gap:20px;}
.notification-detail dl {display:grid; gap:10px;}
@media(max-width:700px){.notification-layout.has-selection{grid-template-columns:minmax(0,1fr)}.notification-filters{align-items:stretch; flex-direction:column;gap:18px}.notification-list li{gap:10px;flex-wrap:wrap}.notification-list li>div{min-width:160px}.notification-detail{grid-row:1}.notification-icon{width:28px;height:30px}}

/* Creation shows each editable value once; keep the existing card groups. */
.workbench-create--entry { grid-template-columns:minmax(0,1fr); }
.workbench-create--entry .workbench-create__fields { grid-template-columns:repeat(2,minmax(0,1fr)); }
@media(max-width:700px) { .workbench-create--entry .workbench-create__fields { grid-template-columns:1fr; } }
