import './records.css';
import { useEffect,useState } from 'react';
import { Link } from '@tanstack/react-router';
import { OperatorShell,OperatorState } from './operator-shell';
import { recordsRequest,type CustomerRecord,type RecordKind } from './records-api';
import { RecordEditor } from './record-editor';
import { ManualEntry } from './manual-entry';
import { RecordsDataTools } from './records-data-tools';
export function RecordsPage(){const [kind,setKind]=useState<RecordKind>('opportunity'),[query,setQuery]=useState(''),[filters,setFilters]=useState<Record<string,string>>({}),[records,setRecords]=useState<CustomerRecord[]>([]),[companies,setCompanies]=useState<CustomerRecord[]>([]),[contacts,setContacts]=useState<CustomerRecord[]>([]),[settings,setSettings]=useState<any>(),[detail,setDetail]=useState<any>(),[editing,setEditing]=useState(false),[entry,setEntry]=useState<any>(),[error,setError]=useState('');
 async function reload(){try{setError('');const [list,company,contact,workspace]=await Promise.all([recordsRequest<{records:CustomerRecord[]}>(`records/${kind}?${new URLSearchParams({q:query,...filters})}`),recordsRequest<{records:CustomerRecord[]}>('records/company'),recordsRequest<{records:CustomerRecord[]}>('records/contact'),recordsRequest('settings')]);setRecords(list.records);setCompanies(company.records);setContacts(contact.records);setSettings(workspace);}catch(e){setError((e as Error).message);}}
 useEffect(()=>{void reload();},[kind,query,JSON.stringify(filters)]);
 async function open(id:string){try{setDetail(await recordsRequest(`records/${kind}/${id}`));setEditing(false);setEntry(undefined);}catch(e){setError((e as Error).message);}}
 async function action(path:string,method:string,body?:unknown){try{await recordsRequest(path,method,body);await reload();if(detail)await open(detail.record.id);}catch(e){setError((e as Error).message);}}
 const title=editing?`${detail?'Update':'Create'} ${kind}`:detail?(detail.record.name??detail.record.title??detail.record.email):'Customer records';
 return <OperatorShell eyebrow="Accounts and opportunities" title={title} action={kind==='opportunity'?<Link className="operator-button" to="/app/new">Create opportunity</Link>:<button className="operator-button" onClick={()=>{setDetail(undefined);setEditing(true);}}>Create {kind}</button>}><div className="records-workspace"><nav className="records-tabs" aria-label="Record types">{(['opportunity','contact','company'] as RecordKind[]).map(type=><button key={type} disabled={!settings} aria-pressed={kind===type} onClick={()=>{setKind(type);setFilters({});setDetail(undefined);setEditing(false);}}>{type==='company'?'Companies':type==='opportunity'?'Opportunities':'Contacts'}</button>)}</nav>{kind==='opportunity'&&!detail&&!editing?<button className="records-secondary-action" onClick={()=>setEditing(true)}>Create from existing records</button>:null}{error?<OperatorState kind="error">{error}</OperatorState>:null}
 {editing?<RecordEditor key={detail?.record.id??kind} kind={kind} record={detail?{...detail.record,contact_ids:detail.contacts.map((c:any)=>c.id),primary_contact_id:detail.contacts.find((c:any)=>c.is_primary)?.id}:undefined} companies={[...new Map([...companies,...(detail?.company?[detail.company]:[])].map(c=>[c.id,c])).values()]} contacts={[...new Map([...contacts,...(detail?.contacts??[])].map(c=>[c.id,c])).values()]} settings={settings} onSaved={id=>{void reload();void open(id);}} onCancel={()=>setEditing(false)}/>:detail?<><div className="operator-surface workbench-actions"><button onClick={()=>setDetail(undefined)}>Back to records</button><button onClick={()=>setEditing(true)}>Edit details</button>{kind==='opportunity'?<Link to="/app/opportunities/$id" params={{id:detail.record.id}}>Evidence and outreach</Link>:null}<button onClick={async()=>{if(confirm(kind==='contact'?'Delete this contact and permanently erase their personal history? This also clears notifications and AI error details for their linked opportunities, including shared opportunities. AI usage totals remain.':`Delete this ${kind}?`)){try{await recordsRequest(`records/${kind}/${detail.record.id}`,'DELETE',{confirmed:true});setDetail(undefined);await reload();}catch(e){setError((e as Error).message);}}}}>Delete record</button></div><div className="workbench-create"><section className="operator-surface workbench-form"><h2>Record details</h2><dl className="records-detail-list">{Object.entries(detail.record).filter(([key])=>!['id','email_key','primary_domain_key','company_id','stage_id','owner_id','custom_fields_json'].includes(key)).map(([key,value])=><div key={key}><dt>{key.replaceAll('_',' ').replace(/^./,letter=>letter.toUpperCase())}</dt><dd>{String(value??'None').replace('do_not_contact','Do not contact')}</dd></div>)}{Object.entries(JSON.parse(detail.record.custom_fields_json??'{}')).map(([key,value])=><div key={key}><dt>{key}</dt><dd>{String(value??'None')}</dd></div>)}</dl>{kind==='opportunity'?<><h3>Lifecycle</h3>{['open','won','lost'].map(state=><button key={state} onClick={()=>{const reason=state==='open'?'':prompt('Reason for closing this opportunity');if(reason!==null)void action(`records/opportunity/${detail.record.id}/lifecycle`,'POST',{state,reason});}}>{state==='open'?'Reopen':`Close ${state}`}</button>)}</>:null}</section><aside className="operator-surface workbench-summary"><h2>Related records</h2>{detail.contacts.map((c:any)=><p key={c.id}>{c.name??c.email} · {c.contactability==='do_not_contact'?'Do not contact':'Contactable'}</p>)}{detail.opportunities.map((o:any)=><p key={o.id}><Link to="/app/opportunities/$id" params={{id:o.id}}>{o.title}</Link> · {o.stage_name??o.stage_id} · {o.owner_name??'Unassigned'} · {o.value_cents/100}</p>)}{kind==='company'?<p>Open opportunity value: {detail.openValueCents/100} {settings?.workspace?.currency}</p>:null}</aside></div><ManualEntry key={entry?.id??detail.record.id} kind={kind} id={detail.record.id} contacts={contacts} entry={entry} onSaved={()=>void open(detail.record.id)}/><section className="operator-surface workbench-form"><h2>Timeline</h2>{detail.timeline.map((item:any)=><article key={item.id}><h3>{item.kind}</h3><p>Occurred {item.occurred_at} · Recorded {item.recorded_at} · {item.actor_id??item.source}</p><pre style={{whiteSpace:'pre-wrap'}}>{item.payload_json}</pre>{item.kind.startsWith('manual.')?<><button onClick={()=>setEntry(item)}>Edit entry</button><button onClick={()=>void action(`records/${kind}/${detail.record.id}/entries/${item.id}`,'DELETE')}>Delete entry</button></>:null}</article>)}</section></>:<><section className="operator-surface workbench-form"><label>Search records and timeline<input value={query} onChange={e=>setQuery(e.target.value)} type="search"/></label>{kind==='opportunity'?<div>{[['lifecycle',['open','won','lost']],['band',['low','medium','high']],['queue_state',['now','next','none']]].map(([field,options])=><label key={String(field)}>{String(field)==='lifecycle'?'Status':String(field)==='band'?'Priority band':'Queue'}<select value={filters[String(field)]??''} onChange={e=>setFilters({...filters,[String(field)]:e.target.value})}><option value="">All</option>{(options as string[]).map(value=><option key={value}>{value}</option>)}</select></label>)}{[['stage_id',settings?.stages??[]],['owner_id',settings?.operators??[]]].map(([field,options])=><label key={String(field)}>{String(field)==='stage_id'?'Stage':'Owner'}<select value={filters[String(field)]??''} onChange={e=>setFilters({...filters,[String(field)]:e.target.value})}><option value="">All</option>{(options as any[]).map(o=><option key={o.id} value={o.id}>{o.name??o.display_name}</option>)}</select></label>)}</div>:null}</section><ol className="operator-queue__list">{records.map(item=><li className="operator-queue-card" key={item.id}><button onClick={()=>void open(item.id)}><h2>{item.title??item.name??item.email}</h2><p>{kind==='company'?(item.primary_domain??'No primary domain'):kind==='contact'?(item.contactability==='do_not_contact'?'Do not contact':'Contactable'):[item.lifecycle,item.band,item.queue_state].filter(Boolean).join(' · ')}</p></button></li>)}</ol>{!records.length?<OperatorState>No matching records.</OperatorState>:null}<RecordsDataTools kind={kind} onChanged={()=>void reload()}/></>}
 </div></OperatorShell>;}
