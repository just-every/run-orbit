import {Hono} from 'hono';
import {z} from 'zod';
import type {AuthService,AuthenticatedOperator} from '../auth';
import {archiveImportActive} from '../../platform/archive-maintenance';
import {boundedRequestBody,RequestBodyTooLarge} from '../../platform/bounded-request-body';
import {DelegationError,deny,hash,random,scopes,targetSchema,effectSchema} from './protocol';
import {snapshot} from './evidence';
import {writeHandoff} from './effects';
const esc=(s:unknown)=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
const page=(title:string,body:string)=>`<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>${esc(title)} · Orbit</title></head><body><main><a href="/app/settings">Orbit settings</a><h1>${esc(title)}</h1>${body}</main></body></html>`;
const consentSchema=z.object({client_id:z.string(),redirect_uri:z.string().url(),response_type:z.literal('code'),state:z.string().min(16).max(1024),code_challenge:z.string().regex(/^[A-Za-z0-9_-]{43}$/),code_challenge_method:z.literal('S256'),account_id:z.literal('workspace'),scope:z.string().min(1),targets:z.string().max(16000)}).strict();
export function nativeDelegationRoutes(db:D1Database,auth:AuthService){
 const app=new Hono<{Variables:{operator:AuthenticatedOperator}}>();
 app.onError((e,c)=>{c.header('Cache-Control','no-store');if(String(e).includes('delegation_grants.consent_key'))return c.json({error:{code:'INVALID_REQUEST',message:'INVALID_REQUEST'}},400);if(e instanceof DelegationError)return c.json({error:{code:e.code,message:e.code}},e.status as 400);return c.json({error:{code:'UNAVAILABLE',message:'UNAVAILABLE'}},503);});
 app.use('*',async(c,next)=>{c.header('Cache-Control','no-store');try{if(await archiveImportActive(db))deny(503,'UNAVAILABLE');const operator=await auth.authenticate(c.req.header('Cookie'));if(!operator)return c.redirect('/signin?returnTo='+encodeURIComponent(c.req.path+'?'+new URL(c.req.url).searchParams.toString()));c.set('operator',operator);if(c.req.method!=='GET'){if(c.req.header('Origin')!==new URL(c.req.url).origin)deny(403,'SCOPE_DENIED');const body=await boundedRequestBody(c.req.raw,64*1024);c.req.raw=new Request(c.req.raw,{body});}await next();}catch(e){if(e instanceof RequestBodyTooLarge)return c.json({error:{code:'SOURCE_TOO_LARGE',message:'SOURCE_TOO_LARGE'}},413);if(e instanceof DelegationError)return c.json({error:{code:e.code,message:e.code}},e.status as 400);return c.json({error:{code:'INVALID_REQUEST',message:'INVALID_REQUEST'}},400);}});
 app.get('/settings',async c=>{const clients=(await db.prepare('SELECT * FROM delegation_clients').all()).results,grants=(await db.prepare('SELECT id,client_id,principal_id,expires_at,revoked_at,scopes_json,targets_json FROM delegation_grants').all()).results;return c.html(page('Connected applications',`<p>Only allowlisted applications can request explicit consent. Delegation cannot approve or send customer mail or activate an account.</p><form method="post" action="/delegation/clients"><label>Client identifier <input name="id" required maxlength="100"></label><label>Exact callback URL <input name="redirect_uri" type="url" required></label><label><input type="checkbox" name="allow_loopback" value="1">Allow local loopback callback for local testing</label><button>Register application</button></form><h2>Applications</h2>${clients.map(x=>`<p>${esc(x.id)} — ${esc(x.redirect_uri)} · ${x.enabled?'enabled':'disabled'}</p><form method="post" action="/delegation/clients/${encodeURIComponent(String(x.id))}/disable"><button>Disable application</button></form>`).join('')}<h2>Delegations</h2>${grants.map(x=>`<article><h3>${esc(x.client_id)}</h3><p>Operator ${esc(x.principal_id)} · expires ${esc(x.expires_at)} · ${x.revoked_at?'revoked':'active'}</p><p>${esc(x.scopes_json)} ${esc(x.targets_json)}</p><form method="post" action="/delegation/grants/${esc(x.id)}/revoke"><button>Revoke</button></form></article>`).join('')}`));});
 app.post('/clients',async c=>{const p=z.object({id:z.string().regex(/^[A-Za-z0-9_-]{1,100}$/),redirect_uri:z.string().url(),allow_loopback:z.literal('1').optional()}).strict().safeParse(await c.req.parseBody());if(!p.success)deny(400,'INVALID_REQUEST');const x=p.data!,url=new URL(x.redirect_uri);if(url.username||url.password||url.hash||!(url.protocol==='https:'||(x.allow_loopback&&url.protocol==='http:'&&['localhost','127.0.0.1','[::1]'].includes(url.hostname))))deny(400,'INVALID_REQUEST');await db.prepare('INSERT INTO delegation_clients(id,redirect_uri,origin,allow_loopback) VALUES(?,?,?,?)').bind(x.id,url.href,url.origin,x.allow_loopback?1:0).run();return c.redirect('/delegation/settings',303);});
 app.post('/clients/:id/disable',async c=>{await db.batch([db.prepare('UPDATE delegation_clients SET enabled=0 WHERE id=?').bind(c.req.param('id')),db.prepare('UPDATE delegation_grants SET revoked_at=? WHERE client_id=?').bind(new Date().toISOString(),c.req.param('id'))]);return c.redirect('/delegation/settings',303);});
 app.post('/grants/:id/revoke',async c=>{await db.prepare('UPDATE delegation_grants SET revoked_at=? WHERE id=?').bind(new Date().toISOString(),c.req.param('id')).run();return c.redirect('/delegation/settings',303);});
 async function validate(input:unknown){const p=consentSchema.safeParse(input);if(!p.success)deny(400,'INVALID_REQUEST');const x=p.data!,client=await db.prepare('SELECT * FROM delegation_clients WHERE id=? AND redirect_uri=? AND enabled=1').bind(x.client_id,x.redirect_uri).first();if(!client)deny(400,'INVALID_REQUEST');const selected=x.scope.split(' ');if(new Set(selected).size!==selected.length||selected.some(s=>!scopes.includes(s as typeof scopes[number])))deny(403,'SCOPE_DENIED');let targets:unknown;try{targets=JSON.parse(x.targets);}catch{deny(400,'INVALID_REQUEST');}const parsed=z.array(targetSchema).min(1).max(100).safeParse(targets);if(!parsed.success)deny(400,'INVALID_REQUEST');for(const target of parsed.data!)await snapshot(db,target,true);return {x,client,selected,targets:parsed.data!};}
 app.get('/authorize',async c=>{const {x,client,selected,targets}=await validate(c.req.query());return c.html(page('Authorize application',`<p>${esc(client!.origin)} requests access as ${esc(c.get('operator').displayName)} in workspace.</p><p>Expires in 30 days. Customer mail and account activation are not included.</p><h2>Capabilities</h2><ul>${selected.map(s=>`<li>${esc(s)}</li>`).join('')}</ul><h2>Selected records</h2><ul>${targets.map(s=>`<li>${esc(s)}</li>`).join('')}</ul><form method="post" action="/delegation/authorize">${Object.entries(x).map(([k,v])=>`<input type="hidden" name="${esc(k)}" value="${esc(v)}">`).join('')}<button>Allow selected access</button></form><a href="/app/settings">Cancel</a>`));});
 app.post('/authorize',async c=>{const {x,selected,targets}=await validate(await c.req.parseBody()),operator=c.get('operator'),now=new Date(),id=random(),code=random();const consentKey=await hash(operator.sessionId+'|'+x.client_id+'|'+x.state);await db.batch([db.prepare(`INSERT INTO delegation_grants(id,client_id,principal_id,account_id,scopes_json,targets_json,expires_at,consent_key) SELECT ?,?,?,?,?,?,?,? WHERE EXISTS(SELECT 1 FROM operators WHERE id=? AND status='active') AND EXISTS(SELECT 1 FROM delegation_clients WHERE id=? AND redirect_uri=? AND enabled=1) AND NOT EXISTS(SELECT 1 FROM runtime_controls WHERE name='archive_import')`).bind(id,x.client_id,operator.operatorId,x.account_id,JSON.stringify(selected),JSON.stringify(targets),new Date(now.getTime()+30*86400000).toISOString(),consentKey,operator.operatorId,x.client_id,x.redirect_uri),db.prepare('INSERT INTO delegation_codes(hash,grant_id,challenge,expires_at) VALUES(?,?,?,?)').bind(await hash(code),id,x.code_challenge,new Date(now.getTime()+600000).toISOString())]);const url=new URL(x.redirect_uri);url.searchParams.set('code',code);url.searchParams.set('state',x.state);return c.redirect(url.href,303);});
 app.get('/handoffs/:id',async c=>{const tasks=(await db.prepare('SELECT id FROM handoff_tasks WHERE opportunity_id=? ORDER BY created_at,id').bind(c.req.param('id')).all<{id:string}>()).results;const entries=[];for(const t of tasks){const target=`opportunities/${c.req.param('id')}/handoffs/${t.id}`,s=await snapshot(db,target);entries.push({target,revision:s.revision,audienceRevision:s.audience.audienceRevision,task:s.value.handoff});}return c.json({tasks:entries,operators:(await db.prepare("SELECT id,display_name FROM operators WHERE status='active' ORDER BY display_name,id").all()).results});});
 app.post('/handoffs',async c=>{const p=effectSchema.safeParse(await c.req.json());if(!p.success)deny(400,'INVALID_REQUEST');return c.json(await writeHandoff(db,p.data!,{actor:c.get('operator').operatorId}));});
 return app;
}
