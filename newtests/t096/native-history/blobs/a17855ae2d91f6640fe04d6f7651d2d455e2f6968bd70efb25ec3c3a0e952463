import {useEffect,useState} from 'react';
import './handoff-tasks.css';
type Task={id:string;title:string;description:string;assignee_id:string|null;due_at:string|null;status:'open'|'completed'|'cancelled'};
type Entry={target:string;revision:string;audienceRevision:string;task:Task};
export function HandoffTasks({opportunityId,onChange}:{opportunityId:string;onChange:()=>void}){
 const [entries,setEntries]=useState<Entry[]>([]),[operators,setOperators]=useState<{id:string;display_name:string}[]>([]),[error,setError]=useState(''),[pending,setPending]=useState(false);
 async function load(){const response=await fetch(`/delegation/handoffs/${opportunityId}`);if(!response.ok)throw new Error('Handoffs could not be loaded.');const data=await response.json() as {tasks:Entry[];operators:{id:string;display_name:string}[]};setEntries(data.tasks);setOperators(data.operators);}
 useEffect(()=>{void load().catch(e=>setError(e.message));},[opportunityId]);
 async function save(entry:Entry,form:HTMLFormElement){setPending(true);setError('');const data=new FormData(form);try{const response=await fetch('/delegation/handoffs',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({operationKey:crypto.randomUUID(),operation:'orbit.handoff.upsert',target:entry.target,expectedRevision:entry.revision,expectedAudienceRevision:entry.audienceRevision,content:{title:String(data.get('title')),description:String(data.get('description')),assigneeId:data.get('assigneeId')||null,dueAt:data.get('dueAt')?new Date(String(data.get('dueAt'))+'Z').toISOString():null,status:data.get('status')}})});if(!response.ok)throw new Error(response.status===409?'The task, opportunity or audience changed. Reload and review before saving.':'The handoff update failed; reload to inspect its current state.');await load();onChange();}catch(e){setError((e as Error).message);}finally{setPending(false);}}
 return <section className="operator-surface operator-detail__section operator-handoff-tasks" data-testid="handoff-tasks"><h2>Onboarding handoffs</h2><p>These are internal CRM tasks. Completion does not send customer mail or activate a customer account.</p>{error&&<p role="alert">{error}</p>}<button type="button" onClick={()=>void load().catch(e=>setError(e.message))}>Reload handoffs</button>{entries.length===0?<p>No onboarding handoffs.</p>:entries.map(entry=><form key={entry.task.id+entry.revision} onSubmit={e=>{e.preventDefault();void save(entry,e.currentTarget);}}><h3>{entry.task.title}</h3><label>Title<input name="title" required maxLength={300} defaultValue={entry.task.title}/></label><label>Description<textarea name="description" maxLength={20000} defaultValue={entry.task.description}/></label><label>Assignee<select name="assigneeId" defaultValue={entry.task.assignee_id??''}><option value="">Unassigned</option>{operators.map(o=><option key={o.id} value={o.id}>{o.display_name}</option>)}</select></label><label>Due time (UTC)<input name="dueAt" type="datetime-local" defaultValue={entry.task.due_at?.slice(0,16)??''}/></label><label>Status<select name="status" defaultValue={entry.task.status}><option value="open">Open</option><option value="completed">Completed</option><option value="cancelled">Cancelled</option></select></label><button disabled={pending}>Save handoff</button></form>)}</section>;
}
