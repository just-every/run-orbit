import {deny,hash,type Grant} from './protocol';
export async function currentGrant(db:D1Database,id:string){const g=await db.prepare(`SELECT g.* FROM delegation_grants g JOIN operators o ON o.id=g.principal_id JOIN delegation_clients c ON c.id=g.client_id JOIN workspace_settings w ON w.id=g.account_id WHERE g.id=? AND g.revoked_at IS NULL AND g.expires_at>? AND o.status='active' AND c.enabled=1`).bind(id,new Date().toISOString()).first<Grant>();if(!g)deny(401,'DELEGATION_INVALID');return g!;}
export async function bearer(db:D1Database,header:string|undefined){if(!header?.match(/^Bearer [a-f0-9]{64}$/))deny(401,'DELEGATION_INVALID');const g=await db.prepare('SELECT id FROM delegation_grants WHERE token_hash=?').bind(await hash(header!.slice(7))).first<{id:string}>();if(!g)deny(401,'DELEGATION_INVALID');return currentGrant(db,g!.id);}
export function guard(db:D1Database,id:string,epoch:number,grant?:Grant,actor?:string){return db.prepare(`INSERT INTO delegation_guards(id,valid) SELECT ?,CASE WHEN (SELECT epoch FROM delegation_installation)=? AND NOT EXISTS(SELECT 1 FROM runtime_controls WHERE name='archive_import') AND EXISTS(SELECT 1 FROM operators WHERE id=? AND status='active') ${grant?`AND EXISTS(SELECT 1 FROM delegation_grants g JOIN delegation_clients c ON c.id=g.client_id JOIN workspace_settings w ON w.id=g.account_id WHERE g.id=? AND g.revoked_at IS NULL AND g.expires_at>strftime('%Y-%m-%dT%H:%M:%fZ','now') AND c.enabled=1)`:''} THEN 1 ELSE 0 END`).bind(id,epoch,grant?.principal_id??actor,...(grant?[grant.id]:[]));}
