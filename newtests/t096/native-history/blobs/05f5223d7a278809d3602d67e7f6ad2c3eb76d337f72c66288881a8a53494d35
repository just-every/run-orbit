import {Link} from '@tanstack/react-router';
import documentIcon from '../../../../assets/design/assistance-cutout-24-607cce6690f6.png';
import goalIcon from '../../../../assets/design/assistance-cutout-36-6a0a4e1e9164.png';
import recipientIcon from '../../../../assets/design/assistance-recipient.svg';
import instructionsIcon from '../../../../assets/design/assistance-instructions.svg';
import warningIcon from '../../../../assets/design/assistance-warning.svg';

export interface AssistancePreview {
 id:string;configured:boolean;provider?:string;model?:string;
 preview:{opportunity:{title:string;value_cents:number;[key:string]:unknown};contact:Record<string,unknown>|null;company:{name:string}|null;workspace:{name:string;currency:string}|null;evidence:{id:string;type:string;subject:string|null;occurred_at:string;confidence:string;source_id:string}[];instructions:string;messages:unknown[];replies:unknown[];[key:string]:unknown};
}
const text=(value:unknown)=>typeof value==='string'?value:'';
export function AssistanceRequestPreview({preview,feature,opportunityId,recipientLabel,busy,onRevise,onGenerate}:{preview:AssistancePreview;feature:'draft'|'explanation';opportunityId:string;recipientLabel:string;busy:boolean;onRevise:()=>void;onGenerate:()=>void}){
 const request=preview.preview,contact=request.contact;
 const value=request.workspace?.currency?new Intl.NumberFormat('en-AU',{style:'currency',currency:request.workspace.currency,maximumFractionDigits:2}).format(request.opportunity.value_cents/100):`${request.opportunity.value_cents} minor units`;
 return <div className="assistance-preview">
  <section className="assistance-card assistance-opportunity" aria-labelledby="preview-opportunity"><div><p className="assistance-label">Selected opportunity</p><h2 id="preview-opportunity">{request.opportunity.title}</h2>{request.company&&<p className="assistance-muted">{request.company.name}</p>}</div><div className="assistance-value"><p>Opportunity value</p><strong>{value}</strong>{request.workspace&&<span>{request.workspace.currency}</span>}</div></section>
  <div className="assistance-columns">
   <section className="assistance-card" aria-labelledby="preview-evidence"><h2 className="assistance-label" id="preview-evidence">Evidence references</h2><p className="assistance-card-lead">This request includes {request.evidence.length} cited {request.evidence.length===1?'signal':'signals'}.</p><div className="assistance-evidence">{request.evidence.map(entry=><details key={entry.id}><summary><img src={documentIcon} alt=""/><span><strong>{entry.subject??entry.type.replaceAll(/[._]/g,' ')}</strong><small>{entry.type.replaceAll(/[._]/g,' ')} · {new Date(entry.occurred_at).toLocaleString('en-AU',{dateStyle:'medium',timeStyle:'short'})}</small></span><span className="assistance-chevron" aria-hidden="true">›</span></summary><dl><div><dt>Evidence ID</dt><dd>{entry.id}</dd></div><div><dt>Source ID</dt><dd>{entry.source_id}</dd></div><div><dt>Confidence</dt><dd>{entry.confidence}</dd></div></dl></details>)}</div></section>
   <section className="assistance-card" aria-labelledby="preview-recipient"><h2 className="assistance-label" id="preview-recipient">Recipient &amp; goal</h2><div className="assistance-context-row"><img src={recipientIcon} alt=""/><div><h3>Recipient</h3>{contact?<><p className="assistance-serif">{text(contact.name)||text(contact.email)}</p>{text(contact.name)&&text(contact.email)&&<p className="assistance-muted">{text(contact.email)}</p>}<span className="assistance-badge">{recipientLabel}</span></>:<p>No contact selected</p>}</div></div><div className="assistance-context-row assistance-goal"><img src={goalIcon} alt=""/><div><h3>Goal</h3><p className="assistance-serif">{feature==='draft'?'Write a one-to-one follow-up draft from the cited evidence.':'Explain the current recommended action using its cited evidence.'}</p></div></div></section>
  </div>
  <section className="assistance-card" aria-labelledby="preview-instructions"><h2 className="assistance-label" id="preview-instructions">Instructions &amp; exclusions</h2><div className="assistance-context-row"><img src={instructionsIcon} alt=""/><div><h3>Exact instructions</h3><p className="assistance-instructions">{request.instructions}</p></div></div></section>
  <section className="assistance-card" aria-labelledby="preview-complete"><details className="assistance-complete"><summary aria-label="View complete request"><span><span className="assistance-label" id="preview-complete">View complete request</span><span className="assistance-muted">All fields, {request.messages.length} outbound {request.messages.length===1?'message':'messages'} and {request.replies.length} {request.replies.length===1?'reply':'replies'}</span></span><span className="assistance-chevron" aria-hidden="true">›</span></summary><p>Every field below is sent to {preview.provider??'the configured provider'}{preview.model?` using ${preview.model}`:''}.</p><pre className="assistance-exact-json">{JSON.stringify(request,null,2)}</pre></details></section>
  {!preview.configured&&<aside className="assistance-provider" role="status"><img src={warningIcon} alt=""/><div><h2>AI provider required</h2><p>AI is not configured. A request cannot generate content until the owner configures its provider.</p></div></aside>}
  <div className="assistance-card assistance-actions"><button className="assistance-button assistance-button--outline" onClick={onRevise} disabled={busy}>← Revise inputs</button><Link className="assistance-button assistance-button--cancel" to="/app/opportunities/$id" params={{id:opportunityId}}>Cancel</Link><button className="assistance-button assistance-button--generate" onClick={onGenerate} disabled={busy||!preview.configured}>{busy?'Generating…':`Generate ${feature}`}</button></div>
 </div>;
}
