import { createId } from '../../shared/ids';
import { IngestionRepository } from '../ingestion/repository';
import { OutreachRepository } from '../workbench/outreach-repository';
import {IngestionError,type SignalEvent} from '../ingestion/contracts';
export interface ProviderEvent {sg_event_id:string;event:string;timestamp:number;email:string;sg_message_id?:string;rer_delivery_id?:string;rer_product?:string;reason?:string;type?:string}
export class ProviderRepository {
 constructor(readonly db:D1Database){}
 async event(event:ProviderEvent,hash:string){
  if(event.rer_product&&event.rer_product!=='orbit')return;
  if(!event.rer_product&&!/^[0-9A-HJKMNP-TV-Z]{26}$/.test(event.rer_delivery_id??''))return;
  const previous=await this.db.prepare('SELECT payload_hash FROM mail_provider_events WHERE id=?').bind(event.sg_event_id).first<{payload_hash:string}>();if(previous){if(previous.payload_hash!==hash)throw new Error('Provider event identity has conflicting payload.');return;}
  const message=event.rer_delivery_id?await this.db.prepare('SELECT * FROM outbound_messages WHERE idempotency_key=?').bind(event.rer_delivery_id).first<{id:string;operator_id:string;opportunity_id:string;contact_id:string;state:string;provider_message_id:string|null}>():event.sg_message_id?await this.db.prepare('SELECT * FROM outbound_messages WHERE provider_message_id=?').bind(event.sg_message_id).first<{id:string;operator_id:string;opportunity_id:string;contact_id:string;state:string;provider_message_id:string|null}>():null;
  // Foreign account events do not mutate records in this deployment.
  if(!message)return;
  if(['processed','delivered','bounce','dropped'].includes(event.event)&&['queued','reconciling','delivery-unknown'].includes(message.state))await new OutreachRepository(this.db).settle(message.id,message.operator_id,'accepted',event.sg_message_id??message.provider_message_id,null);
  const at=new Date().toISOString(),statements=[this.db.prepare("INSERT OR IGNORE INTO signal_sources(id,name,type,enabled,created_at,updated_at) VALUES('sendgrid-events','SendGrid delivery events','mail_provider',1,?,?)").bind(at,at),this.db.prepare('INSERT INTO mail_provider_events(id,payload_hash,created_at) VALUES(?,?,?)').bind(event.sg_event_id,hash,at)];
  const next=event.event==='delivered'?'delivered':event.event==='bounce'?'bounced':event.event==='dropped'?'failed':null;
  if(next)statements.push(this.db.prepare("UPDATE outbound_messages SET state=?,failure=?,updated_at=? WHERE id=? AND state IN('accepted','delivered')").bind(next,event.reason??null,at,message.id));
  if(['bounce','dropped'].includes(event.event))statements.push(this.db.prepare("UPDATE opportunities SET queue_state='now',queue_reason='Delivery problem',next_due_at=NULL WHERE id=? AND lifecycle='open'").bind(message.opportunity_id));
  if(['unsubscribe','group_unsubscribe','spamreport'].includes(event.event)||(event.event==='bounce'&&event.type==='bounce'))statements.push(this.db.prepare("UPDATE contacts SET contactability='do_not_contact',updated_at=? WHERE id=?").bind(at,message.contact_id),this.db.prepare("UPDATE drafts SET is_stale=1,stale_reason='Provider stop event',updated_at=? WHERE recipient_contact_id=?").bind(at,message.contact_id),this.db.prepare("UPDATE outbound_messages SET state='cancelled',failure='Provider stop event',updated_at=? WHERE contact_id=? AND state='scheduled'").bind(at,message.contact_id));
  const timelineId=createId();statements.push(this.db.prepare("INSERT INTO timeline_entries(id,kind,occurred_at,recorded_at,actor_type,actor_id,source,payload_json) VALUES(?,?,?,?,'source','sendgrid-events','sendgrid',?)").bind(timelineId,`provider.${event.event}`,new Date(event.timestamp*1000).toISOString(),at,JSON.stringify({messageId:message.id,providerEventId:event.sg_event_id,reason:event.reason??null})),this.db.prepare("INSERT INTO timeline_entry_records(timeline_entry_id,record_type,record_id) VALUES(?,'opportunity',?)").bind(timelineId,message.opportunity_id));
  try{await this.db.batch(statements);}catch(error){const replay=await this.db.prepare('SELECT payload_hash FROM mail_provider_events WHERE id=?').bind(event.sg_event_id).first<{payload_hash:string}>();if(replay?.payload_hash!==hash)throw error;}
 }
 async unlinkedReplies(){return (await this.db.prepare('SELECT id,sender,subject,body,occurred_at FROM unlinked_replies WHERE opportunity_id IS NULL ORDER BY occurred_at DESC LIMIT 100').all()).results;}
 async linkReply(id:string,opportunityId:string,actor:string){
  const row=await this.db.prepare('SELECT * FROM unlinked_replies WHERE id=? AND opportunity_id IS NULL').bind(id).first<{provider_event_id:string;sender:string;subject:string;body:string;occurred_at:string;message_id:string;reference_ids:string}>();
  if(!row)throw new IngestionError(409,'Reply is missing or already linked.');if(!await this.db.prepare('SELECT id FROM opportunities WHERE id=?').bind(opportunityId).first())throw new IngestionError(404,'Opportunity not found.');
  const event:SignalEvent={eventId:row.provider_event_id,type:'email.replied',subject:row.subject,occurredAt:row.occurred_at,record:{type:'opportunity',id:opportunityId},data:{body:row.body,messageId:row.message_id,references:row.reference_ids,linkedBy:actor}};
  const raw=JSON.stringify(event),hash=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(raw))),b=>b.toString(16).padStart(2,'0')).join('');
  await new IngestionRepository(this.db).ingest('sendgrid-replies',event,hash,raw);await this.db.prepare('UPDATE unlinked_replies SET opportunity_id=? WHERE id=? AND opportunity_id IS NULL').bind(opportunityId,id).run();
 }
 async reply(input:{id:string;sender:string;subject:string;body:string;messageId:string;references:string;occurredAt:string},hash:string){
  const ids=input.references.match(/<[^<>\r\n]+>/g)??[];
  const messages=ids.length?await this.db.prepare(`SELECT DISTINCT opportunity_id,contact_id FROM outbound_messages WHERE message_id IN(${ids.map(()=>'?').join(',')})`).bind(...ids).all<{opportunity_id:string;contact_id:string}>():{results:[]};
  const opportunities=new Set(messages.results.map(message=>message.opportunity_id));
  const opportunityId=opportunities.size===1?messages.results[0]!.opportunity_id:null;
  const existing=await this.db.prepare('SELECT id FROM unlinked_replies WHERE provider_event_id=?').bind(input.id).first();if(existing)return;
  const source='sendgrid-replies',at=new Date().toISOString();
  await this.db.prepare("INSERT OR IGNORE INTO signal_sources(id,name,type,enabled,created_at,updated_at) VALUES(?,'SendGrid authenticated replies','mail_provider',1,?,?)").bind(source,at,at).run();
  const event:SignalEvent={eventId:input.id,type:'email.replied',subject:input.subject,occurredAt:input.occurredAt,...(opportunityId?{record:{type:'opportunity',id:opportunityId} as const}:{}),data:{body:input.body,messageId:input.messageId,references:input.references}};
  if(opportunityId){await new IngestionRepository(this.db).ingest(source,event,hash,JSON.stringify(event));for(const contact of new Set(messages.results.map(message=>message.contact_id)))await this.db.batch([this.db.prepare("UPDATE drafts SET is_stale=1,stale_reason='Customer reply',updated_at=? WHERE recipient_contact_id=?").bind(at,contact),this.db.prepare("UPDATE outbound_messages SET state='cancelled',failure='Customer reply',updated_at=? WHERE contact_id=? AND state='scheduled'").bind(at,contact)]);}
  await this.db.prepare('INSERT INTO unlinked_replies(id,provider_event_id,sender,subject,body,message_id,reference_ids,occurred_at,opportunity_id) VALUES(?,?,?,?,?,?,?,?,?) ON CONFLICT(provider_event_id) DO NOTHING').bind(createId(),input.id,input.sender,input.subject,input.body,input.messageId,input.references,input.occurredAt,opportunityId).run();
 }
}
