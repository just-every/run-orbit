-- Fixed, owner-reviewed D1 landing publication. No remote provider or workflow engine.
CREATE TABLE content_entities(id TEXT PRIMARY KEY,kind TEXT NOT NULL CHECK(kind IN('form','landing','artifact')),revision INTEGER NOT NULL,body_json TEXT NOT NULL,content_hash TEXT NOT NULL,created_by TEXT NOT NULL REFERENCES operators(id),updated_at TEXT NOT NULL);
CREATE TABLE content_revisions(id TEXT NOT NULL,revision INTEGER NOT NULL,kind TEXT NOT NULL,body_json TEXT NOT NULL,content_hash TEXT NOT NULL,created_by TEXT NOT NULL,created_at TEXT NOT NULL,PRIMARY KEY(id,revision));
CREATE TABLE access_form_authorities(id TEXT PRIMARY KEY,form_id TEXT NOT NULL,form_revision INTEGER NOT NULL,custodian_id TEXT NOT NULL REFERENCES operators(id),artifact_hash TEXT NOT NULL,max_records INTEGER NOT NULL CHECK(max_records BETWEEN 1 AND 1000),captured_records INTEGER NOT NULL DEFAULT 0,expires_at TEXT NOT NULL,revoked_at TEXT);
CREATE TABLE publication_operations(id TEXT PRIMARY KEY,slug TEXT NOT NULL,form_id TEXT NOT NULL,form_revision INTEGER NOT NULL,artifact_id TEXT NOT NULL,artifact_hash TEXT NOT NULL,authority_id TEXT NOT NULL,state TEXT NOT NULL CHECK(state IN('compiled','approved','published','withdrawn')),approved_by TEXT,approved_at TEXT,published_at TEXT,receipt_json TEXT);
CREATE TABLE publication_targets(slug TEXT PRIMARY KEY,operation_id TEXT NOT NULL REFERENCES publication_operations(id),revision INTEGER NOT NULL);
CREATE TABLE marketing_form_submissions(id TEXT PRIMARY KEY,form_id TEXT NOT NULL,operation_id TEXT NOT NULL,idempotency_key TEXT NOT NULL,payload_hash TEXT NOT NULL,contact_id TEXT,signal_id TEXT,values_json TEXT NOT NULL,review_required INTEGER NOT NULL,created_at TEXT NOT NULL,UNIQUE(form_id,idempotency_key));
CREATE TABLE consent_events(id TEXT PRIMARY KEY,submission_id TEXT NOT NULL REFERENCES marketing_form_submissions(id),contact_id TEXT,wording TEXT NOT NULL,form_revision INTEGER NOT NULL,artifact_hash TEXT NOT NULL,occurred_at TEXT NOT NULL);
CREATE TRIGGER fold_content_history_insert AFTER INSERT ON content_entities WHEN NOT EXISTS(SELECT 1 FROM runtime_controls WHERE name='restore') BEGIN INSERT INTO content_revisions VALUES(NEW.id,NEW.revision,NEW.kind,NEW.body_json,NEW.content_hash,NEW.created_by,NEW.updated_at); END;
CREATE TRIGGER fold_content_history_update AFTER UPDATE ON content_entities WHEN NOT EXISTS(SELECT 1 FROM runtime_controls WHERE name='restore') BEGIN INSERT INTO content_revisions VALUES(NEW.id,NEW.revision,NEW.kind,NEW.body_json,NEW.content_hash,NEW.created_by,NEW.updated_at); END;
CREATE TRIGGER fold_capture_erasure AFTER DELETE ON contacts BEGIN UPDATE marketing_form_submissions SET contact_id=NULL,signal_id=NULL,values_json='{}' WHERE contact_id=OLD.id;UPDATE consent_events SET contact_id=NULL WHERE contact_id=OLD.id;END;

CREATE TRIGGER fold_artifact_immutable_update BEFORE UPDATE ON content_entities WHEN OLD.kind='artifact' AND NOT EXISTS(SELECT 1 FROM runtime_controls WHERE name='restore') BEGIN SELECT RAISE(ABORT,'PUBLISHED_ARTIFACT_IMMUTABLE');END;
CREATE TRIGGER fold_artifact_immutable_delete BEFORE DELETE ON content_entities WHEN OLD.kind='artifact' AND NOT EXISTS(SELECT 1 FROM runtime_controls WHERE name='restore') BEGIN SELECT RAISE(ABORT,'PUBLISHED_ARTIFACT_IMMUTABLE');END;
