+// Node normally destroys both halves of a socket on a write error. An HTTP
+// peer may stop accepting an upload while its response remains readable.
+// Linux can report its pending reset as ECONNRESET on write before EPIPE;
+// neither write error proves that the HTTP response has been read.
+function preserveResponseAfterUploadClose(outgoing, stopUpload) {
+  outgoing.once('socket', socket => {
+    let incoming, pending, deadline;
+    const settle = () => {
+      clearTimeout(deadline);
+      const callback = pending;
+      pending = undefined;
+      callback?.();
+    };
+    outgoing.once('response', response => {
+      incoming = response;
+      clearTimeout(deadline);
+      response.once('end', settle);
+      response.once('error', settle);
+    });
+    socket.once('close', settle);
+    for (const method of ['_write', '_writev']) {
+      const write = socket[method];
+      socket[method] = function (...args) {
+        const callback = args[args.length - 1];
+        args[args.length - 1] = error => {
+          const uploadClosed = error?.code === 'EPIPE' || error?.code === 'ECONNRESET';
+          if (!uploadClosed || error.syscall !== 'write' || incoming?.complete || socket.destroyed) {
+            callback(error);
+            return;
+          }
+          // Hold the failed write callback: never acknowledge rejected bytes or
+          // release queued writes. The original error settles it after the real
+          // response finishes or its read side fails/closes.
+          pending = () => callback(error);
+          stopUpload();
+          if (!incoming) {
+            // No response has begun. Bound this exceptional waiting state;
+            // ordinary response streaming retains its normal lifetime.
+            deadline = setTimeout(() => socket.destroy(error), 2000);
+            deadline.unref();
+          }
+        };
+        return write.apply(this, args);
+      };
+    }
+  });
+}
+module.exports = { preserveResponseAfterUploadClose };
