{
  "schema": 1,
  "title": "Orbit",
  "groups": [
    {
      "id": "owner",
      "label": "First owner"
    },
    {
      "id": "mail",
      "label": "Sign-in email"
    }
  ],
  "fields": [
    {
      "name": "OWNER_EMAIL",
      "label": "Owner email",
      "help": "This address becomes the first owner of your Orbit workspace.",
      "kind": "email",
      "required": true,
      "prefill": "account-email",
      "group": "owner"
    },
    {
      "name": "WORKSPACE_NAME",
      "label": "Business name",
      "kind": "text",
      "required": false,
      "businessField": "display_name",
      "group": "owner"
    },
    {
      "name": "OWNER_NAME",
      "label": "Owner name",
      "kind": "text",
      "required": false,
      "businessField": "owner_name",
      "group": "owner"
    },
    {
      "name": "WORKSPACE_TIMEZONE",
      "label": "Business time zone",
      "kind": "text",
      "required": false,
      "businessField": "timezone",
      "group": "owner"
    },
    {
      "name": "SESSION_SECRET",
      "label": "Sign-in secret",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "SETUP_TOKEN",
      "label": "Setup token",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "ORBIT_ENCRYPTION_KEY",
      "label": "Source encryption key",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "MAIL_PROVIDER",
      "label": "Mail provider",
      "kind": "select",
      "required": true,
      "default": "sendgrid",
      "options": [
        {
          "value": "development",
          "label": "Automatic local sign-in on this computer"
        },
        {
          "value": "rer",
          "label": "Run Edit Run managed mail"
        },
        {
          "value": "sendgrid",
          "label": "Your SendGrid account"
        }
      ],
      "group": "mail"
    },
    {
      "name": "MAIL_FROM",
      "label": "Sender email",
      "help": "The address sign-in email comes from. Managed hosting assigns it; your own SendGrid account requires a verified sender.",
      "kind": "email",
      "required": true,
      "group": "mail"
    },
    {
      "name": "MAIL_RELAY_URL",
      "label": "Managed mail relay URL",
      "help": "Assigned by Run Edit Run managed hosting.",
      "kind": "url",
      "required": true,
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "rer"
      },
      "group": "mail"
    },
    {
      "name": "MAIL_API_KEY",
      "label": "Managed mail key",
      "help": "Assigned by Run Edit Run managed hosting.",
      "kind": "secret",
      "required": true,
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "rer"
      },
      "ownerVisible": true,
      "input": "entered",
      "group": "mail"
    },
    {
      "name": "SENDGRID_API_KEY",
      "label": "SendGrid API key",
      "help": "A SendGrid key with Mail Send permission for the verified sender address.",
      "kind": "secret",
      "required": true,
      "group": "mail",
      "ownerVisible": true,
      "input": "entered",
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "sendgrid"
      }
    },
    {
      "name": "IDENTITY_PROVIDER",
      "label": "Identity provider",
      "kind": "url",
      "required": false,
      "default": "",
      "help": "Optional Auth install. Leave empty to sign in with email links.",
      "group": "owner"
    }
  ],
  "steps": [
    {
      "type": "owner-claim",
      "mode": "signed",
      "emailField": "OWNER_EMAIL",
      "tokenField": "SETUP_TOKEN",
      "path": "/auth/owner-claim"
    }
  ],
  "dependencies": [
    {
      "interface": "oidc-provider@1",
      "optional": true,
      "cardinality": 1,
      "address": "IDENTITY_PROVIDER",
      "paths": [
        "/auth/oidc/auth/callback",
        "/auth/oidc/auth/logout"
      ]
    }
  ],
  "business": {
    "settings": 1,
    "values": [
      "display_name",
      "owner_name",
      "timezone"
    ],
    "team": {
      "roles": {
        "admin": "native",
        "member": "native"
      }
    }
  }
}
