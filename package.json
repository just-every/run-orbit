{
  "name": "orbit",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "setup": "rer setup",
    "dev": "rer dev",
    "preview": "rer preview",
    "build": "rer build",
    "verify": "rer verify",
    "reset": "rer reset",
    "deploy": "rer deploy",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "build:app": "rer queue build:app -- vite build --logLevel warn",
    "verify:app": "rer queue verify:app -- node scripts/verify.mjs",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test": "playwright test",
    "test:list": "playwright test --list",
    "test:worker": "tsx scripts/verify-worker.ts",
    "check:manifest": "node tools/seed-schema/validate.mjs --schema SEED seed.json",
    "deployment:spec": "node scripts/publish-deployment-spec.mjs",
    "deployment:check": "node scripts/publish-deployment-spec.mjs --check",
    "report:contract": "node scripts/report-contract-results.mjs",
    "test:capacity": "tsx tests/performance/records-capacity.ts",
    "test:archive": "playwright test --config tests/archive/playwright.config.mjs",
    "source:check": "node node_modules/@runeditrun/rer/edition-authoring/cli.mjs check",
    "source:release": "node node_modules/@runeditrun/rer/edition-authoring/cli.mjs release",
    "test:delegation": "tsx --test --test-concurrency=1 tests/delegation/*.test.ts",
    "test:delegation-browser": "tsx --test tests/delegation-browser/native.test.ts",
    "test:delegation-viewport": "tsx --test tests/delegation-browser/viewport.test.ts",
    "test:records-layout": "tsx --test tests/delegation-browser/records-layout.test.ts",
    "test:related-records": "tsx --test tests/delegation-browser/related-records.test.ts",
    "build:artifact": "node scripts/build-delivery-artifact.mjs",
    "test:launch-runtime": "tsx --test --test-concurrency=1 tests/launch-runtime/*.test.ts",
    "test:core": "tsx --test --test-concurrency=1 tests/core/*.test.ts",
    "verify:release": "rer queue verify:app -- node scripts/verify.mjs --release",
    "agent:surface": "tsx scripts/agent-surface.ts --check"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ulidx": "2.4.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.64.1",
    "@runeditrun/rer": "0.2.87",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.17",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "highlight.js": "10.7.3",
    "react-markdown": "6.0.3",
    "remark-gfm": "1.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  },
  "pnpm": {
    "patchedDependencies": {
      "miniflare@5.20260907.0-alpha": "patches/miniflare-5.20260907.0-alpha.patch",
      "wrangler@4.129.1": "patches/wrangler-4.129.1.patch"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
